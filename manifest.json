    <div class="panel-actions">
      <button class="button" data-prog-action="export">Export progress</button>
      <button class="button danger" data-prog-action="reset">Reset progress</button>
    </div>
  </div>
  <div class="hist-scroll"><table class="hist-table">
    <thead><tr><th>Date</th><th>Scope</th><th>Mode</th><th class="num">Answered</th><th class="num">Time</th><th class="num">Score</th></tr></thead>
    <tbody>${history.map(x=>{
      const pct=x.total?Math.round(x.correct/x.total*100):0;
      return `<tr><td class="h-date">${e(fmtDate(x.ts))}</td><td class="h-scope">${e(x.scope)}</td>
<td class="h-scope">${x.mode==='exam'?'Test':'Tutor'}</td>
<td class="num">${x.answered}/${x.total}</td><td class="num">${fmtClock(x.dur)}</td>
<td class="num"><span class="score-chip ${band(pct)}">${x.correct}/${x.total} · ${pct}%</span></td></tr>`;
    }).join('')}</tbody>
  </table></div>
  <div class="tiny-note">Progress is stored in this browser only. Clearing site data or using a different device starts a fresh record.</div>
</div>`;

  host.querySelectorAll('[data-practice-cat]').forEach(el=>el.onclick=()=>startTargeted({
    cat:el.dataset.practiceCat,kind:'weak',count:20,scope:el.dataset.practiceCat,
    emptyMessage:'Every question in that category is already at 80% or better'
  }));
  host.querySelectorAll('[data-focus-action]').forEach(el=>el.onclick=()=>{
    const d=el.dataset;
    startTargeted({cat:d.focusCat||null,lens:d.focusLens||null,kind:d.focusKind||'weak',
      count:Number(d.focusCount)||20,scope:d.focusScope||'Targeted practice',
      emptyMessage:'Nothing left to revisit there'});
  });
  const jump=host.querySelector('[data-prog-action="categories"]');
  if(jump)jump.onclick=()=>showView('categories');
  const exp=host.querySelector('[data-prog-action="export"]');
  if(exp)exp.onclick=exportProgress;
  const rst=host.querySelector('[data-prog-action="reset"]');
  if(rst)rst.onclick=resetAllProgress;
}

function buildFocusCards(s){
  const cards=[];
  const weakCats=rankedCategories().filter(r=>r.stats.accuracy<75).slice(0,3);
  weakCats.forEach((r,i)=>{
    const pct=Math.round(r.stats.accuracy);
    cards.push(`<div class="card focus-card ${pct<50?'':'tone-warn'}">
<span class="f-rank">Weakest category · ${i+1}</span>
<h4>${e(r.cat)}</h4>
<div class="f-metric"><strong>${pct}%</strong><span>${r.stats.correct}/${r.stats.attempts} attempts</span></div>
<p>${r.stats.weak+r.stats.fair} of ${r.stats.seen} seen questions are still under 80%, and ${r.stats.unseen} have not been attempted.</p>
<button class="button" data-focus-action data-focus-cat="${e(r.cat)}" data-focus-kind="weak" data-focus-count="20" data-focus-scope="${e(r.cat)}">Practise 20</button></div>`);
  });

  const weakLens=rankedLenses().filter(r=>r.stats.accuracy<75)[0];
  if(weakLens){
    const pct=Math.round(weakLens.stats.accuracy);
    cards.push(`<div class="card focus-card tone-warn">
<span class="f-rank">Weakest reasoning lens</span>
<h4>${e(LENS_LABEL[weakLens.lens]||weakLens.lens)} questions</h4>
<div class="f-metric"><strong>${pct}%</strong><span>${weakLens.stats.correct}/${weakLens.stats.attempts} attempts</span></div>
<p>This lens lags your ${Math.round(s.accuracy)}% overall accuracy. A mixed set across every category will expose the pattern.</p>
<button class="button" data-focus-action data-focus-lens="${e(weakLens.lens)}" data-focus-kind="weak" data-focus-count="20" data-focus-scope="${e(LENS_LABEL[weakLens.lens]||weakLens.lens)} lens">Practise 20</button></div>`);
  }

  const wrong=incorrectIds().length;
  if(wrong){
    cards.push(`<div class="card focus-card">
<span class="f-rank">Last answer incorrect</span>
<h4>Questions you got wrong</h4>
<div class="f-metric"><strong>${wrong}</strong><span>awaiting a correct answer</span></div>
<p>Re-attempting questions you missed is the highest-yield use of a short study block.</p>
<button class="button" data-focus-action data-focus-kind="incorrect" data-focus-count="20" data-focus-scope="Incorrect questions">Retry 20</button></div>`);
  }

  const thinnest=categories.map(cat=>({cat,stats:poolStats(CAT_INDEX.get(cat)||[])}))
    .filter(r=>r.stats.unseen>0)
    .sort((a,b)=>a.stats.coverage-b.stats.coverage)[0];
  if(thinnest&&cards.length<6){
    cards.push(`<div class="card focus-card tone-info">
<span class="f-rank">Least covered</span>
<h4>${e(thinnest.cat)}</h4>
<div class="f-metric"><strong>${Math.round(thinnest.stats.coverage)}%</strong><span>covered</span></div>
<p>${thinnest.stats.unseen} of ${thinnest.stats.total} questions here are still unseen — the largest blind spot in the bank.</p>
<button class="button" data-focus-action data-focus-cat="${e(thinnest.cat)}" data-focus-kind="unseen" data-focus-count="20" data-focus-scope="${e(thinnest.cat)} (new)">Start 20 new</button></div>`);
  }

  if(!cards.length){
    cards.push(`<div class="card focus-card tone-good" style="grid-column:1/-1">
<span class="f-rank">Nothing flagged for repair</span>
<h4>Every category you have practised sits at 75% or better</h4>
<div class="f-metric"><strong>${Math.round(s.accuracy)}%</strong><span>overall accuracy</span></div>
<p>Widen coverage next — ${s.unseen.toLocaleString()} questions in the bank are still unseen.</p>
<button class="button" data-focus-action data-focus-kind="unseen" data-focus-count="20" data-focus-scope="New questions">Start 20 new</button></div>`);
  }
  return cards.join('');
}

/* ---------- categories page ---------- */
let catSortMode='name';
function renderCategories(){
  const grid=document.getElementById('categoryGrid');
  if(!grid)return;
  const searchEl=document.getElementById('catSearch');
  const term=(searchEl?searchEl.value:'').trim().toLowerCase();
  let rows=categories.map(cat=>({cat,stats:poolStats(CAT_INDEX.get(cat)||[])}));
  if(term)rows=rows.filter(r=>r.cat.toLowerCase().includes(term));

  if(catSortMode==='weakest'){
    rows.sort((a,b)=>{
      if(!a.stats.attempts&&!b.stats.attempts)return a.cat.localeCompare(b.cat);
      if(!a.stats.attempts)return 1;
      if(!b.stats.attempts)return -1;
      return a.stats.accuracy-b.stats.accuracy;
    });
  }else if(catSortMode==='least'){
    rows.sort((a,b)=>a.stats.coverage-b.stats.coverage||a.cat.localeCompare(b.cat));
  }else if(catSortMode==='largest'){
    rows.sort((a,b)=>b.stats.total-a.stats.total||a.cat.localeCompare(b.cat));
  }else{
    rows.sort((a,b)=>a.cat.localeCompare(b.cat));
  }

  const summary=document.getElementById('catSummary');
  if(summary){
    const all=overallStats();
    summary.textContent=`${rows.length} of ${categories.length} categories · ${all.seen.toLocaleString()} of ${all.total.toLocaleString()} questions answered`;
  }

  if(!rows.length){
    grid.innerHTML='<div class="card empty" style="grid-column:1/-1">No category matches that search.</div>';
    return;
  }

  grid.innerHTML=rows.map(r=>{
    const st=r.stats;
    const pct=st.attempts?Math.round(st.accuracy):0;
    const accCls=st.attempts?(pct<50?'low':pct<75?'mid':''):'none';
    return `<div class="card category-card">
<div class="cc-top"><h4>${e(r.cat)}</h4><span class="cc-count">${st.total} questions</span></div>
<div class="cc-track"><span class="cc-fill" style="width:${st.coverage.toFixed(1)}%"></span></div>
<div class="cc-meta"><span>${st.seen}/${st.total} answered · ${Math.round(st.coverage)}%</span>
<span class="cc-acc ${accCls}">${st.attempts?pct+'% correct':'Not started'}</span></div>
<div class="cc-actions">
<button class="button primary" data-cat-start="${e(r.cat)}">Practise</button>
<button class="button" data-cat-weak="${e(r.cat)}"${st.attempts?'':' disabled'}>Weak spots</button>
<button class="button ghost" data-cat-key="${e(r.cat)}">Answer key</button>
</div></div>`;
  }).join('');

  grid.querySelectorAll('[data-cat-start]').forEach(b=>b.onclick=()=>openCategory(b.dataset.catStart));
  grid.querySelectorAll('[data-cat-weak]').forEach(b=>b.onclick=()=>startTargeted({
    cat:b.dataset.catWeak,kind:'weak',count:20,scope:b.dataset.catWeak,
    emptyMessage:'Every question in that category is already at 80% or better'
  }));
  grid.querySelectorAll('[data-cat-key]').forEach(b=>b.onclick=()=>{
    showView('answers');
    const sel=document.getElementById('answerCategory');
    sel.value=b.dataset.catKey;
    renderAnswerKey();
  });
}

function buildSelects(){const opts=['<option value="all">All categories</option>',...categories.map(c=>`<option value="${e(c)}">${e(c)} (${META.categoryCounts[c]})</option>`)].join('');document.getElementById('quizCategory').innerHTML=opts;document.getElementById('answerCategory').innerHTML=categories.map(c=>`<option value="${e(c)}">${e(c)} (${META.categoryCounts[c]})</option>`).join('')}
function examInProgress(){return !!(session&&!session.finished)}
/* In-app confirm. Native confirm() is not dependable in an installed PWA -
   some platforms suppress it, and a suppressed dialog resolves to false, which
   silently cancels whatever it was guarding. */
function askConfirm(opts){
  return new Promise(resolve=>{
    const modal=document.getElementById('examModal');
    const title=document.getElementById('examModalTitle');
    const body=document.getElementById('examModalBody');
    const ok=document.getElementById('examModalConfirm');
    const cancel=document.getElementById('examModalCancel');
    title.textContent=opts.title||'Are you sure?';
    body.innerHTML=opts.body||'';
    ok.textContent=opts.okLabel||'Continue';
    cancel.textContent=opts.cancelLabel||'Cancel';
    ok.classList.toggle('danger',opts.danger!==false);
    modal.classList.add('open');
    ok.focus();
    const close=(v)=>{
      modal.classList.remove('open');
      ok.onclick=null;cancel.onclick=null;modal.onclick=null;
      document.removeEventListener('keydown',onKey,true);
      resolve(v);
    };
    const onKey=(ev)=>{if(ev.key==='Escape'){ev.stopPropagation();close(false)}};
    ok.onclick=()=>close(true);
    cancel.onclick=()=>close(false);
    modal.onclick=(ev)=>{if(ev.target===modal)close(false)};
    document.addEventListener('keydown',onKey,true);
  });
}
function askLeaveExam(){
    const strict=session&&session.mode==='exam';
    const n=session?session.ids.filter(id=>session.selected[id]===undefined).length:0;
    const plural=n===1?'':'s';
    return askConfirm({
      title:'Exam in progress',
      body:strict
        ?'You are sitting a test-mode exam and it has to be finished before you can move '
         +'elsewhere in the app.<br><br>Finishing now submits it and shows your results. '
         +'<strong>'+n+'</strong> unanswered question'+plural
         +' will be marked incorrect and recorded against your progress.'
        :'Leaving now ends this tutor-mode exam.<br><br>Answers you already submitted are kept. '
         +'<strong>'+n+'</strong> unanswered question'+plural
         +' will not be recorded and will stay in your unattempted pool.',
      okLabel:strict?'Finish and submit exam':'End exam and leave',
      cancelLabel:'Stay in the exam'
    });
}
function showView(name){
  if(examInProgress()&&name!=='quiz'){
    askLeaveExam().then(go=>{
      if(!go)return;
      if(session.mode==='exam'){
        finishSession();       /* records unanswered as incorrect */
        toast('Exam submitted \u2014 your results are below');
      }else{
        /* tutor mode: commit what was answered, discard the rest */
        commitSession();saveState();
        clearInterval(timerHandle);
        session=null;
        resetQuizUI();
        renderGlobal();
        showViewNow(name);
      }
    });
    return;
  }
  showViewNow(name);
}
function showViewNow(name){currentView=name;document.querySelectorAll('.view').forEach(v=>v.classList.toggle('active',v.id===`view-${name}`));document.querySelectorAll('.nav button').forEach(b=>b.classList.toggle('active',b.dataset.view===name));const titles={"dashboard":["Dashboard","Practice, revision and progress in one place"],"disclaimer":["Disclaimer","Educational use, affiliation and accuracy of content"],"quiz":["Practice exam","Build a focused set or simulate exam conditions"],"categories":["Categories","Coverage and accuracy across all 22 categories"],"progress":["Progress","Attempts, accuracy and the areas worth revisiting"],"answers":["Answer key","Answers, explanations and learning points by category"],"review":["Saved questions","Bookmarked, flagged and incorrect questions"]};const t=titles[name]||titles.dashboard;document.getElementById('pageTitle').textContent=t[0];document.getElementById('pageSubtitle').textContent=t[1];document.getElementById('sidebar').classList.remove('open');if(name==='answers')renderAnswerKey();if(name==='review')renderGlobal();if(name==='categories')renderCategories();if(name==='progress')renderProgress()}
function openCategory(cat){if(examInProgress()){showView('dashboard');return}showView('quiz');document.getElementById('quizCategory').value=cat;document.getElementById('quizSetup').scrollIntoView({behavior:'smooth',block:'start'})}
const LENS_LABEL={diagnosis:'Diagnosis',management:'Management',discriminator:'Discriminator',pitfall:'Pitfall',complication:'Complication',calculation:'Calculation'};
const LENS_ORDER=['diagnosis','management','discriminator','pitfall','complication','calculation'];
function poolFor(cat,lens){return QUESTIONS.filter(q=>(cat==='all'||q.category===cat)&&(!lens||lens==='all'||q.type===lens))}
function poolForCategory(cat){return poolFor(cat,'all')}
function startSession(ids,mode='study',order='random',scope='Mixed',limitSec=0){const clean=validIds(ids);if(!clean.length){toast('No questions available');return}const arranged=order==='random'?shuffle(clean):[...clean];session={id:newId(),ids:arranged,index:0,mode,scope,selected:{},submitted:{},recorded:{},committed:false,started:Date.now(),finished:false,flags:[],limit:(mode==='exam'&&Number(limitSec)>0)?Number(limitSec):0,expired:false};document.getElementById('quizSetup').style.display='none';document.getElementById('quizResults').classList.remove('active');document.getElementById('quizShell').classList.add('active');startTimer();renderQuestion()}
function startConfigured(){const cat=document.getElementById('quizCategory').value;const lensSel=document.getElementById('quizLens');const lens=lensSel?lensSel.value:'all';const pool=poolFor(cat,lens);if(!pool.length){toast('No questions match that category and lens');return}const countRaw=document.getElementById('quizCount').value;let count;if(countRaw==='all'){count=pool.length}else if(countRaw==='custom'){  const typed=Math.floor(Number(document.getElementById('quizCountCustom').value));  if(!Number.isFinite(typed)||typed<1){toast('Enter how many questions you want');    document.getElementById('quizCountCustom').focus();return}  count=Math.min(typed,pool.length);  if(typed>pool.length)toast(`Only ${pool.length} questions available — using all of them`);}else{count=Math.min(Number(countRaw),pool.length)}const order=document.getElementById('quizOrder').value;const ids=(order==='random'?shuffle(pool):pool).slice(0,count).map(q=>q.id);const lensLabel=lens&&lens!=='all'?` · ${LENS_LABEL[lens]||lens}`:'';const mode=document.getElementById('quizMode').value;let limitSec=0;if(mode==='exam'){  const tv=document.getElementById('quizTimer').value;  if(tv==='custom'){    const mins=Math.floor(Number(document.getElementById('quizTimerCustom').value));    if(!Number.isFinite(mins)||mins<1){toast('Enter a time limit in minutes');      document.getElementById('quizTimerCustom').focus();return}    limitSec=mins*60;  }else{limitSec=Number(tv)||0}}startSession(ids,mode,order,`${cat==='all'?'Mixed':cat}${lensLabel}`,limitSec)}
function specialIds(kind){if(kind==='bookmarks')return validIds(state.bookmarks);return []}
function startSpecial(kind){const ids=kind==='incorrect'?incorrectIds():specialIds(kind);const labels={bookmarks:'No bookmarks yet',incorrect:'No incorrect questions to review'};if(!ids.length){toast(labels[kind]||'No questions available');return}const scopes={bookmarks:'Bookmarks',incorrect:'Incorrect questions'};showView('quiz');startSession(ids,'study',kind==='incorrect'?'random':'sequential',scopes[kind]||'Review')}
function currentQ(){return session?byId.get(session.ids[session.index]):null}
function renderQuestionNavigator(){if(!session)return;const grid=document.getElementById('questionNumberGrid');grid.innerHTML=session.ids.map((id,index)=>{const q=byId.get(id);const answered=session.selected[id]!==undefined;const submitted=!!session.submitted[id];const flagged=isFlagged(id);let cls='qnav-button';if(index===session.index)cls+=' current';if(answered)cls+=' answered';if(flagged)cls+=' flagged';if(submitted&&session.mode==='study')cls+=session.selected[id]===q.answerIndex?' correct':' incorrect';const title=`Question ${index+1}: ${q.category} Q${q.categoryNumber}${flagged?' · flagged':''}`;return `<button class="${cls}" data-index="${index}" title="${e(title)}" aria-label="${e(title)}"><span>${index+1}</span>${flagged?`<span class="flag-dot">${uiIcon('flagFilled')}</span>`:''}</button>`}).join('');grid.querySelectorAll('button').forEach(button=>button.onclick=()=>{session.index=Number(button.dataset.index);renderQuestion();document.querySelector('.quiz-main-column').scrollIntoView({behavior:'smooth',block:'start'})});const answered=session.ids.filter(id=>session.selected[id]!==undefined).length;const flagged=session.ids.filter(isFlagged).length;document.getElementById('questionNavigatorSummary').textContent=`${answered} answered · ${flagged} flagged`}
function renderQuestion(){const q=currentQ();if(!q)return;const submitted=!!session.submitted[q.id];const selected=session.selected[q.id];document.getElementById('qCategory').textContent=q.category;const typeEl=document.getElementById('qType');typeEl.textContent=LENS_LABEL[q.type]||q.type;typeEl.setAttribute('data-lens',q.type);document.getElementById('qPosition').textContent=`${session.index+1} of ${session.ids.length}`;document.getElementById('qNumber').textContent=`${q.category} · Question ${q.categoryNumber}`;document.getElementById('qStem').textContent=q.stem;document.getElementById('sessionBar').style.width=`${(session.index+1)/session.ids.length*100}%`;const bookmarkBtn=document.getElementById('bookmarkBtn');const isBookmarked=state.bookmarks.includes(q.id);setLabeledButton(bookmarkBtn,isBookmarked?'bookmarkFilled':'bookmark','Bookmark');bookmarkBtn.setAttribute('aria-pressed',String(isBookmarked));const flagBtn=document.getElementById('flagBtn');const flaggedNow=isFlagged(q.id);setLabeledButton(flagBtn,flaggedNow?'flagFilled':'flag','Flag');flagBtn.classList.toggle('flag-active',flaggedNow);flagBtn.setAttribute('aria-pressed',String(flaggedNow));const opts=document.getElementById('qOptions');opts.innerHTML=q.options.map((o,i)=>{let cls='option';if(selected===i)cls+=' selected';if(submitted&&session.mode==='study'){if(i===q.answerIndex)cls+=' correct';else if(selected===i)cls+=' incorrect'}return `<button class="${cls}" data-i="${i}" ${submitted&&session.mode==='study'?'disabled':''}><span class="letter">${LETTERS[i]}</span><span>${e(o)}</span></button>`}).join('');opts.querySelectorAll('button').forEach(b=>b.onclick=()=>selectOption(Number(b.dataset.i)));const fb=document.getElementById('qFeedback');if(submitted&&session.mode==='study'){const ok=selected===q.answerIndex;const yours=selected===undefined?'No answer selected':`${LETTERS[selected]}. ${e(q.options[selected])}`;const mark=ok?'<path d="m5 12.5 4.5 4.5L19 7.5"/>':'<path d="M7 7l10 10M17 7 7 17"/>';fb.className=`feedback show ${ok?'good':'bad'}`;fb.innerHTML=`<div class="verdict"><span class="verdict-icon"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true">${mark}</svg></span><div><strong>${ok?'Correct':'Incorrect'}</strong><span class="sub">Your answer: ${yours}</span></div></div><div class="explain-block"><h4>Correct answer</h4><p class="correct-line">${LETTERS[q.answerIndex]}. ${e(q.answer)}</p></div><div class="explain-block"><h4>Explanation</h4><p>${e(q.explanation)}</p></div><div class="rapid-review"><div class="rapid-review-head">Rapid review</div><div class="rapid-review-body">${e(q.learningPoint)}</div></div>`}else{fb.className='feedback';fb.innerHTML=''}document.getElementById('submitQ').textContent=session.mode==='exam'?'Save answer':'Submit answer';document.getElementById('submitQ').disabled=selected===undefined||(submitted&&session.mode==='study');document.getElementById('prevQ').disabled=session.index===0;document.getElementById('nextQ').disabled=session.index===session.ids.length-1;const nextButton=document.getElementById('nextQ');nextButton.innerHTML=session.index===session.ids.length-1?'<span>Last question</span>':`<span>Next</span>${uiIcon('right')}`;const revealed=submitted&&session.mode==='study';document.getElementById('submitQ').classList.toggle('primary',!revealed);nextButton.classList.toggle('primary',revealed&&session.index<session.ids.length-1);renderQuestionNavigator()}
function selectOption(i){if(!session)return;const q=currentQ();if(session.submitted[q.id]&&session.mode==='study')return;session.selected[q.id]=i;renderQuestion()}
function submitCurrent(){const q=currentQ();const sel=session.selected[q.id];if(sel===undefined){toast('Select an answer first');return}session.submitted[q.id]=true;if(session.mode==='study'&&!session.recorded[q.id]){recordAnswer(q,sel);session.recorded[q.id]=true;persist()}renderQuestion();if(session.mode==='exam')toast('Answer saved')}
function finishSession(){if(!session)return;clearInterval(timerHandle);session.finished=true;commitSession();saveState();document.getElementById('quizShell').classList.remove('active');const total=session.ids.length;const answered=session.ids.filter(id=>session.selected[id]!==undefined);const correct=session.ids.filter(id=>session.selected[id]===byId.get(id).answerIndex).length;const unanswered=total-answered.length;const incorrect=total-correct-unanswered;const strictMode=session.mode==='exam';const scoreBase=strictMode?total:answered.length;const pct=scoreBase?Math.round(correct/scoreBase*100):0;const flagged=session.ids.filter(isFlagged).length;const breakdown=session.ids.map((id,index)=>{const q=byId.get(id);const sel=session.selected[id];const status=sel===undefined?'unanswered':sel===q.answerIndex?'correct':'incorrect';const statusLabel=status==='correct'?'Correct':status==='incorrect'?'Incorrect':'Unanswered';const selectedAnswer=sel===undefined?'No answer selected':`${LETTERS[sel]}. ${e(q.options[sel])}`;const correctAnswer=`${LETTERS[q.answerIndex]}. ${e(q.answer)}`;return `<details class="result-question ${status}" open data-result-status="${status}"><summary><span class="result-question-number">Question ${index+1}</span><span class="result-question-category">${e(q.category)} · Q${q.categoryNumber}</span><span class="result-status ${status}">${statusLabel}</span></summary><div class="result-question-body"><h3>${e(q.stem)}</h3><div class="result-answer-grid"><div class="result-answer user-answer"><span>Your answer</span><strong>${selectedAnswer}</strong></div><div class="result-answer correct-answer"><span>Correct answer</span><strong>${correctAnswer}</strong></div></div><div class="result-explanation"><h4>Explanation</h4><p>${e(q.explanation)}</p><p class="result-learning-point"><strong>Learning point:</strong> ${e(q.learningPoint)}</p></div></div></details>`}).join('');const perfBy=key=>{const map=new Map();session.ids.forEach(id=>{const q=byId.get(id);const k=q[key];const row=map.get(k)||{n:0,c:0};row.n++;if(session.selected[id]===q.answerIndex)row.c++;map.set(k,row)});return [...map.entries()].sort((a,b)=>(a[1].c/a[1].n)-(b[1].c/b[1].n))};const perfRows=rows=>rows.map(([k,v])=>{const p=Math.round(v.c/v.n*100);const band=p<50?'low':p<75?'mid':'';return `<div class="perf-row"><span class="perf-name" title="${e(LENS_LABEL[k]||k)}">${e(LENS_LABEL[k]||k)}</span><span class="perf-track"><span class="perf-fill ${band}" style="width:${p}%"></span></span><span class="perf-score">${v.c}/${v.n} · ${p}%</span></div>`}).join('');const lensRows=perfBy('type');const catRows=perfBy('category');const perfPanels=`<div class="perf-grid"><div class="card perf-card"><h3>By reasoning lens</h3><p>Weakest lens first.</p>${perfRows(lensRows)}</div><div class="card perf-card"><h3>By category</h3><p>Weakest category first.</p>${perfRows(catRows)}</div></div>`;const res=document.getElementById('quizResults');res.classList.add('active');res.innerHTML=`<div class="results-summary"><div class="score-ring" style="--score:${pct*3.6}deg"><strong>${pct}%</strong></div><div><div class="eyebrow">${session.expired?'Time expired':'Quiz complete'}</div><h2>${correct} correct of ${scoreBase} ${strictMode?'questions':'answered'}</h2><p class="muted">${incorrect} incorrect · ${unanswered} unanswered · ${flagged} flagged during the exam</p><p class="result-note">${strictMode?`Test mode — every question counts. ${unanswered} unanswered ${unanswered===1?'question was':'questions were'} marked incorrect and recorded.`:`Tutor mode — unanswered questions were not recorded and remain in your unattempted pool.`}</p><div class="result-toolbar"><button class="button primary" id="newQuiz">New quiz</button><button class="button" id="expandResults">Expand all</button><button class="button" id="collapseResults">Collapse all</button><button class="button" id="printResults">Print breakdown</button></div></div></div>${perfPanels}<div class="result-breakdown-heading"><div><h2>Question-by-question breakdown</h2><p class="muted">Each item shows your answer, the correct answer and the explanation.</p></div><div class="result-filter-group"><button class="button result-filter active" data-result-filter="all">All ${total}</button><button class="button result-filter" data-result-filter="incorrect">Incorrect ${incorrect}</button><button class="button result-filter" data-result-filter="unanswered">Unanswered ${unanswered}</button></div></div><div class="result-review-list">${breakdown}</div>`;document.getElementById('newQuiz').onclick=()=>resetQuizUI();document.getElementById('expandResults').onclick=()=>res.querySelectorAll('.result-question').forEach(x=>x.open=true);document.getElementById('collapseResults').onclick=()=>res.querySelectorAll('.result-question').forEach(x=>x.open=false);document.getElementById('printResults').onclick=()=>window.print();res.querySelectorAll('[data-result-filter]').forEach(btn=>btn.onclick=()=>{const filter=btn.dataset.resultFilter;res.querySelectorAll('[data-result-filter]').forEach(x=>x.classList.toggle('active',x===btn));res.querySelectorAll('.result-question').forEach(item=>{item.style.display=filter==='all'||item.dataset.resultStatus===filter?'block':'none'})});renderGlobal();res.scrollIntoView({behavior:'smooth',block:'start'})}
function resetQuizUI(){clearInterval(timerHandle);session=null;document.getElementById('quizResults').classList.remove('active');document.getElementById('quizShell').classList.remove('active');document.getElementById('quizSetup').style.display='block';document.getElementById('quizSetup').scrollIntoView({behavior:'smooth',block:'start'})}
function fmtTimer(sec){
  sec=Math.max(0,Math.floor(sec));
  const h=Math.floor(sec/3600),m=Math.floor(sec%3600/60),s=sec%60;
  const mm=String(m).padStart(2,'0'),ss=String(s).padStart(2,'0');
  return h?`${h}:${mm}:${ss}`:`${mm}:${ss}`;
}
function startTimer(){
  clearInterval(timerHandle);
  const el=document.getElementById('timer');
  const label=document.getElementById('timerLabel');
  const counting=!!(session&&session.limit>0);
  label.textContent=counting?'Time left':'Elapsed';
  const tick=()=>{
    if(!session||session.finished)return;
    const elapsed=Math.floor((Date.now()-session.started)/1000);
    if(counting){
      const left=session.limit-elapsed;
      el.textContent=fmtTimer(left);
      el.classList.toggle('countdown-warn',left<=300&&left>60);
      el.classList.toggle('countdown-critical',left<=60);
      if(left<=0){
        clearInterval(timerHandle);
        session.expired=true;
        el.textContent='00:00';
        toast('Time is up — exam submitted');
        finishSession();
      }
    }else{
      el.classList.remove('countdown-warn','countdown-critical');
      el.textContent=fmtTimer(elapsed);
    }
  };
  tick();
  timerHandle=setInterval(tick,1000);
}
function toggleBookmark(){const q=currentQ();if(!q)return;const i=state.bookmarks.indexOf(q.id);if(i>=0)state.bookmarks.splice(i,1);else state.bookmarks.push(q.id);saveState();renderQuestion()}
/* Flags live only for the duration of the session - they are a within-exam
   navigation aid and are deliberately not persisted once the exam ends. */
function isFlagged(id){return !!(session&&session.flags&&session.flags.indexOf(id)>=0)}
function toggleFlag(){const q=currentQ();if(!q||!session)return;session.flags=session.flags||[];const i=session.flags.indexOf(q.id);if(i>=0){session.flags.splice(i,1);toast('Flag removed')}else{session.flags.push(q.id);toast('Flagged for this exam')}renderQuestion()}
function renderAnswerKey(){const cat=document.getElementById('answerCategory').value||categories[0];const term=document.getElementById('answerSearch').value.trim().toLowerCase();const qs=QUESTIONS.filter(q=>q.category===cat&&(!term||[q.stem,q.answer,q.explanation,q.learningPoint].join(' ').toLowerCase().includes(term)));const list=document.getElementById('answerList');if(!qs.length){list.innerHTML='<div class="card empty">No matching questions.</div>';return}list.innerHTML=`<div class="answer-group"><h3>${e(cat)} · ${qs.length} questions</h3>${qs.map(q=>`<details class="card answer-item" ${answerExpanded?'open':''}><summary>Q${q.categoryNumber}. ${e(q.stem)}</summary><div class="answer-body"><ol class="mini-options" type="A">${q.options.map(o=>`<li>${e(o)}</li>`).join('')}</ol><div class="answer">Answer: ${LETTERS[q.answerIndex]}. ${e(q.answer)}</div><p>${e(q.explanation)}</p><p><strong>Learning point:</strong> ${e(q.learningPoint)}</p></div></details>`).join('')}</div>`}
function exportProgress(){
  try{
    const s=overallStats();
    const payload={app:'Fellowship Examination SCQ App',exported:new Date().toISOString(),
      summary:{questionsAnswered:s.seen,bankSize:s.total,coveragePercent:Math.round(s.coverage),
        attempts:s.attempts,correct:s.correct,accuracyPercent:Math.round(s.accuracy),
        firstPassAccuracyPercent:Math.round(s.firstAccuracy),secondsStudied:prog().time},
      byCategory:categories.map(c=>{const st=poolStats(CAT_INDEX.get(c)||[]);
        return {category:c,total:st.total,answered:st.seen,attempts:st.attempts,correct:st.correct,accuracyPercent:Math.round(st.accuracy)}}),
      byLens:ACTIVE_LENSES.map(l=>{const st=poolStats(LENS_INDEX.get(l)||[]);
        return {lens:LENS_LABEL[l]||l,attempts:st.attempts,correct:st.correct,accuracyPercent:Math.round(st.accuracy)}}),
      sessions:prog().sessions,state};
    const blob=new Blob([JSON.stringify(payload,null,2)],{type:'application/json'});
    const url=URL.createObjectURL(blob);
    const a=document.createElement('a');
    a.href=url;a.download=`scq-progress-${dayKey()}.json`;
    document.body.appendChild(a);a.click();a.remove();
    setTimeout(()=>URL.revokeObjectURL(url),1000);
    toast('Progress exported');
  }catch(err){toast('Export failed')}
}
function resetAllProgress(){
  askConfirm({title:'Reset all progress?',
    body:'Attempts, accuracy, session history and streaks will be permanently deleted from this '
      +'browser. Bookmarks are kept.<br><br>This cannot be undone.',
    okLabel:'Reset progress',cancelLabel:'Cancel'}).then(go=>{
  if(!go)return;
  state.progress=blankProgress();
  saveState();
  renderGlobal();
  toast('Progress reset');
  });
}
function resetProgress(){askConfirm({title:'Clear bookmarks?',body:'This removes every bookmark saved in this browser. Your recorded progress is kept.',okLabel:'Clear bookmarks',cancelLabel:'Keep them'}).then(go=>{if(!go)return;state.bookmarks=[];saveState();renderGlobal();toast('Bookmarks cleared')})}
function init(){state=loadState();setTheme();setRail();buildSelects();renderGlobal();document.getElementById('referenceList').innerHTML=`<p>${e(META.disclaimer)}</p><ol>${META.references.map(r=>`<li>${e(r)}</li>`).join('')}</ol>`;document.querySelectorAll('[data-view]').forEach(b=>b.onclick=()=>showView(b.dataset.view));document.querySelectorAll('[data-view-jump]').forEach(b=>b.onclick=()=>showView(b.dataset.viewJump));document.getElementById('menuBtn').onclick=()=>document.getElementById('sidebar').classList.toggle('open');document.getElementById('railToggle').onclick=()=>{state.railCollapsed=!state.railCollapsed;setRail();saveState()};document.getElementById('themeBtn').onclick=()=>{state.theme=state.theme==='light'?'dark':'light';setTheme();saveState()};document.getElementById('heroStart').onclick=()=>{showView('quiz');syncSetup();document.getElementById('quizSetup').scrollIntoView({behavior:'smooth',block:'start'})};document.getElementById('startQuiz').onclick=startConfigured;document.getElementById('startBookmarks').onclick=()=>startSpecial('bookmarks');document.getElementById('reviewBookmarksBtn').onclick=()=>startSpecial('bookmarks');document.getElementById('clearSavedItems').onclick=resetProgress;const incBtn=document.getElementById('reviewIncorrectBtn');if(incBtn)incBtn.onclick=()=>startSpecial('incorrect');const catSearch=document.getElementById('catSearch');if(catSearch)catSearch.oninput=renderCategories;const catSort=document.getElementById('catSort');if(catSort)catSort.onchange=()=>{catSortMode=catSort.value;renderCategories()};document.getElementById('submitQ').onclick=submitCurrent;document.getElementById('prevQ').onclick=()=>{if(session&&session.index>0){session.index--;renderQuestion()}};document.getElementById('nextQ').onclick=()=>{if(session&&session.index<session.ids.length-1){session.index++;renderQuestion()}};document.getElementById('finishQuiz').onclick=()=>{
  if(!session||session.finished)return;
  const left=session.ids.filter(id=>session.selected[id]===undefined).length;
  if(!left){finishSession();return}
  const plural=left===1?'':'s';
  const subject=left===1?'It':'They';
  askConfirm({
    title:'Finish this exam?',
    body:`<strong>${left}</strong> question${plural} still unanswered.<br><br>`
      +(session.mode==='exam'
        ?`${subject} will be marked incorrect and recorded against your progress.`
        :`${subject} will not be recorded and will stay in your unattempted pool.`),
    okLabel:'Finish exam',
    cancelLabel:'Keep going'
  }).then(go=>{if(go)finishSession()});
};document.getElementById('bookmarkBtn').onclick=toggleBookmark;document.getElementById('flagBtn').onclick=toggleFlag;document.getElementById('answerCategory').onchange=renderAnswerKey;document.getElementById('answerSearch').oninput=renderAnswerKey;document.getElementById('expandAnswers').onclick=()=>{answerExpanded=!answerExpanded;document.getElementById('expandAnswers').textContent=answerExpanded?'Collapse all':'Expand all';renderAnswerKey()};
/* ---- setup: available-pool hint, custom count, test-mode timer ---- */
const countSel=document.getElementById('quizCount');
const countCustomField=document.getElementById('quizCountCustomField');
const countCustom=document.getElementById('quizCountCustom');
const countCustomHint=document.getElementById('quizCountCustomHint');
const poolHint=document.getElementById('quizPoolHint');
const modeSel=document.getElementById('quizMode');
const timerField=document.getElementById('quizTimerField');
const timerSel=document.getElementById('quizTimer');
const timerCustomField=document.getElementById('quizTimerCustomField');
const timerHint=document.getElementById('quizTimerHint');

function availableCount(){
  const cat=document.getElementById('quizCategory').value;
  const lensSel=document.getElementById('quizLens');
  return poolFor(cat,lensSel?lensSel.value:'all').length;
}
function syncSetup(){
  const avail=availableCount();
  poolHint.textContent=`${avail.toLocaleString()} question${avail===1?'':'s'} match this selection`;
  poolHint.classList.toggle('warn',avail===0);

  const custom=countSel.value==='custom';
  countCustomField.style.display=custom?'':'none';
  if(custom){
    countCustom.max=String(Math.max(1,avail));
    const typed=Math.floor(Number(countCustom.value));
    const over=Number.isFinite(typed)&&typed>avail;
    countCustomHint.textContent=over
      ?`Only ${avail.toLocaleString()} available — the exam will use all of them`
      :`Enter any number from 1 to ${avail.toLocaleString()}`;
    countCustomHint.classList.toggle('warn',over);
  }

  const isTest=modeSel.value==='exam';
  timerField.style.display=isTest?'':'none';
  timerCustomField.style.display=(isTest&&timerSel.value==='custom')?'':'none';
  if(isTest){
    timerHint.textContent=timerSel.value==='0'
      ?'Time counts up so you can see how long you took'
      :'The exam submits automatically when the time runs out';
  }
}
countSel.onchange=syncSetup;
countCustom.oninput=syncSetup;
modeSel.onchange=syncSetup;
timerSel.onchange=syncSetup;
document.getElementById('quizCategory').addEventListener('change',syncSetup);
const lensSelEl=document.getElementById('quizLens');
if(lensSelEl)lensSelEl.addEventListener('change',syncSetup);
syncSetup();

/* ---- an exam in progress survives an accidental close or refresh ---- */
window.addEventListener('beforeunload',ev=>{
  if(!examInProgress())return;
  ev.preventDefault();
  ev.returnValue='';
  return '';
});

document.addEventListener('keydown',ev=>{if(currentView!=='quiz'||!session||session.finished)return;if(['1','2','3','4','5'].includes(ev.key))selectOption(Number(ev.key)-1);if(ev.key.toLowerCase()==='b')toggleBookmark();if(ev.key.toLowerCase()==='f')toggleFlag();if(ev.key==='Enter')submitCurrent();if(ev.key.toLowerCase()==='n'&&session.index<session.ids.length-1){session.index++;renderQuestion()}if(ev.key.toLowerCase()==='p'&&session.index>0){session.index--;renderQuestion()}});}
init();

/* ============================================================
   PWA runtime: install, offline, durable storage, drawer
   ============================================================ */
(function(){
  var isStandalone = window.matchMedia('(display-mode: standalone)').matches
                  || window.navigator.standalone === true;
  var isIOS = /iP(hone|ad|od)/.test(navigator.userAgent)
           || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);

  /* ---------- theme-color follows the in-app theme ---------- */
  var _setTheme = setTheme;
  setTheme = function(){
    _setTheme.apply(this, arguments);
    var m = document.querySelector('meta[name="theme-color"]');
    if(m) m.setAttribute('content', state.theme === 'dark' ? '#11140c' : '#435608');
  };
  setTheme();

  /* ---------- service worker ---------- */
  if('serviceWorker' in navigator && location.protocol.indexOf('http') === 0){
    window.addEventListener('load', function(){
      navigator.serviceWorker.register('sw.js').then(function(reg){
        reg.addEventListener('updatefound', function(){
          var sw = reg.installing;
          if(!sw) return;
          sw.addEventListener('statechange', function(){
            if(sw.state === 'installed' && navigator.serviceWorker.controller){
              toast('Update ready \u2014 close and reopen the app');
            }
          });
        });
      }).catch(function(){});
    });
  }

  /* ---------- durable storage: IndexedDB mirror of localStorage ---------- */
  var IDB_NAME = 'scq-bank-store', IDB_STORE = 'kv';
  function idb(){
    return new Promise(function(res, rej){
      var r = indexedDB.open(IDB_NAME, 1);
      r.onupgradeneeded = function(){ r.result.createObjectStore(IDB_STORE) };
      r.onsuccess = function(){ res(r.result) };
      r.onerror = function(){ rej(r.error) };
    });
  }
  function idbSet(k, v){
    return idb().then(function(db){
      return new Promise(function(res, rej){
        var t = db.transaction(IDB_STORE, 'readwrite');
        t.objectStore(IDB_STORE).put(v, k);
        t.oncomplete = function(){ res() };
        t.onerror = function(){ rej(t.error) };
      });
    });
  }
  function idbGet(k){
    return idb().then(function(db){
      return new Promise(function(res, rej){
        var t = db.transaction(IDB_STORE, 'readonly');
        var q = t.objectStore(IDB_STORE).get(k);
        q.onsuccess = function(){ res(q.result) };
        q.onerror = function(){ rej(q.error) };
      });
    });
  }

  var _saveState = saveState;
  saveState = function(){
    _saveState.apply(this, arguments);
    try{ idbSet(STORE_KEY, JSON.parse(JSON.stringify(state))).catch(function(){}) }catch(e){}
  };

  if(navigator.storage && navigator.storage.persist){
    navigator.storage.persisted().then(function(p){ if(!p) navigator.storage.persist() }).catch(function(){});
  }

  // If localStorage was evicted but the IndexedDB copy survived, restore it.
  try{
    idbGet(STORE_KEY).then(function(backup){
      var local = null;
      try{ local = localStorage.getItem(STORE_KEY) }catch(e){}
      if(backup && !local){
        try{ localStorage.setItem(STORE_KEY, JSON.stringify(backup)) }catch(e){}
        state = sanitiseState(backup);
        setTheme(); setRail(); renderGlobal();
        toast('Progress restored');
      } else if(local && !backup){
        idbSet(STORE_KEY, JSON.parse(local)).catch(function(){});
      }
    }).catch(function(){});
  }catch(e){}

  /* ---------- export / import ----------
     Export reuses the app's own exportProgress(), which writes the full stats
     report with `state` embedded, so one file serves as both report and backup. */
  var exportBtn = document.getElementById('scqExportBtn');
  if(exportBtn) exportBtn.onclick = function(){
    if(typeof exportProgress === 'function'){ exportProgress(); return }
    var payload = { app:'Fellowship Examination SCQ App', exported:new Date().toISOString(), state:state };
    var blob = new Blob([JSON.stringify(payload, null, 2)], {type:'application/json'});
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    a.download = 'fex-scq-backup-' + new Date().toISOString().slice(0,10) + '.json';
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(function(){ URL.revokeObjectURL(url) }, 2000);
    toast('Backup file saved');
  };

  var importBtn = document.getElementById('scqImportBtn');
  var importFile = document.getElementById('scqImportFile');
  if(importBtn && importFile){
    importBtn.onclick = function(){ importFile.click() };
    importFile.onchange = function(){
      var f = importFile.files && importFile.files[0];
      if(!f) return;
      var reader = new FileReader();
      reader.onload = function(){
        try{
          var parsed = JSON.parse(reader.result);
          var incoming = parsed && parsed.state ? parsed.state : parsed;
          if(!incoming || typeof incoming !== 'object') throw new Error('shape');
          if(!incoming.bookmarks && !incoming.progress) throw new Error('shape');
          state = sanitiseState(incoming);
          setTheme(); setRail(); saveState();
          toast('Bookmarks and progress restored');
        }catch(err){
          toast('That file is not a valid backup');
        }
        importFile.value = '';
      };
      reader.readAsText(f);
    };
  }

  /* ---------- drawer: backdrop, auto-close, escape ---------- */
  var sidebar = document.getElementById('sidebar');
  var menuBtn = document.getElementById('menuBtn');
  var backdrop = document.createElement('div');
  backdrop.className = 'nav-backdrop';
  backdrop.setAttribute('aria-hidden', 'true');
  document.body.appendChild(backdrop);

  function setDrawer(open){
    sidebar.classList.toggle('open', open);
    backdrop.classList.toggle('show', open);
    if(menuBtn){
      menuBtn.setAttribute('aria-expanded', String(open));
      menuBtn.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
    }
  }
  if(menuBtn) menuBtn.onclick = function(){ setDrawer(!sidebar.classList.contains('open')) };
  backdrop.addEventListener('click', function(){ setDrawer(false) });
  document.addEventListener('keydown', function(ev){
    // leave Escape to the exam modal while it is open
    var modal = document.getElementById('examModal');
    if(modal && modal.classList.contains('open')) return;
    if(ev.key === 'Escape' && sidebar.classList.contains('open')) setDrawer(false);
  });
  sidebar.addEventListener('click', function(ev){
    if(ev.target.closest('button') && window.matchMedia('(max-width:760px)').matches) setDrawer(false);
  });

  /* ---------- manifest shortcuts: ?view=progress ---------- */
  try{
    var wanted = new URLSearchParams(location.search).get('view');
    if(wanted && document.getElementById('view-' + wanted)) showView(wanted);
  }catch(e){}

  /* ---------- install prompt ---------- */
  var deferred = null;
  var note = null;

  function buildNote(){
    var host = document.getElementById('view-dashboard');
    if(!host || note) return;
    note = document.createElement('div');
    note.className = 'install-note';
    note.innerHTML =
      '<div><p><strong>Install this app on your phone.</strong> ' +
      'It then opens full screen from your home screen and works with no signal.</p>' +
      '<ol class="install-steps" id="iosSteps" hidden>' +
      '<li>Tap the Share button in Safari.</li>' +
      '<li>Choose <strong>Add to Home Screen</strong>.</li>' +
      '<li>Tap <strong>Add</strong>.</li></ol></div>' +
      '<div class="install-actions">' +
      '<button class="button" id="installNow">Install</button>' +
      '<button class="button ghost" id="installDismiss">Not now</button></div>';
    host.insertBefore(note, host.firstChild);

    document.getElementById('installNow').onclick = function(){
      if(deferred){
        deferred.prompt();
        deferred.userChoice.then(function(){ deferred = null; note.remove(); note = null });
      } else {
        var steps = document.getElementById('iosSteps');
        if(steps) steps.hidden = false;
        this.disabled = true;
      }
    };
    document.getElementById('installDismiss').onclick = function(){
      try{ localStorage.setItem('scq-install-dismissed', '1') }catch(e){}
      note.remove(); note = null;
    };
  }

  var dismissed = '0';
  try{ dismissed = localStorage.getItem('scq-install-dismissed') || '0' }catch(e){}

  window.addEventListener('beforeinstallprompt', function(ev){
    ev.preventDefault();
    deferred = ev;
    if(!isStandalone && dismissed !== '1') buildNote();
  });

  if(isIOS && !isStandalone && dismissed !== '1') buildNote();
})();
