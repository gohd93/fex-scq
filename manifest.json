<!DOCTYPE html>
<html lang="en"><head>
<meta charset="utf-8">
<meta content="width=device-width,initial-scale=1,viewport-fit=cover" name="viewport">
<meta name="description" content="2,700 single-best-answer questions across 22 emergency medicine categories. Fellowship written examination preparation. Educational use only.">
<meta name="theme-color" content="#435608">
<meta name="color-scheme" content="light dark">
<link rel="manifest" href="manifest.json">
<link rel="icon" href="icons/favicon-32.png" sizes="32x32" type="image/png">
<link rel="apple-touch-icon" href="icons/apple-touch-icon.png">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="FEx SCQ">
<meta name="format-detection" content="telephone=no">
<title>Fellowship Examination SCQ App</title>
<style>
/* ============================================================
   Fellowship Examination SCQ App (FEx SCQ)
   Chrome + identity : ACEM (Green Leaf #435608, Pomegranate #EE3129)
   Question mechanics : Rosh-style single-column runner
   Distractors : category- and lens-matched FACEM-level revision
   ============================================================ */

:root{
  /* institutional */
  --acem:#435608;
  --acem-2:#57700c;
  --acem-deep:#2b3804;
  --acem-tint:#edf1df;
  --pom:#ee3129;
  --pom-deep:#c4231c;
  --pom-tint:#fdeceb;
  --pom-line:#f4b3ae;

  /* surfaces */
  --bone:#f2f3ea;
  --surface:#ffffff;
  --surface-2:#f8f9f2;
  --ink:#1e2417;
  --ink-2:#454e3b;
  --muted:#6d7862;
  --line:#dde0ce;
  --line-2:#c2c7ad;

  /* verdicts */
  --correct:#4a7710;
  --correct-tint:#eef4e0;
  --correct-line:#b3ca88;

  /* lenses */
  --lens-diagnosis:#3d6396;
  --lens-management:#0e6f6a;
  --lens-discriminator:#6f4f9e;
  --lens-pitfall:#ee3129;
  --lens-complication:#a95c07;
  --lens-calculation:#5a6472;

  --rail:248px;
  --radius:12px;
  --radius-sm:9px;
  --shadow-1:0 1px 2px rgba(30,36,23,.07);
  --shadow-2:0 2px 6px rgba(30,36,23,.07),0 12px 32px rgba(30,36,23,.07);
  --ui:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  --display:Optima,Candara,"Gill Sans MT","Gill Sans","Trebuchet MS",var(--ui);
}

:root.dark{
  --acem:#8aa42c;
  --acem-2:#9cb83a;
  --acem-deep:#0f1408;
  --acem-tint:#20290d;
  --pom:#ff6b60;
  --pom-deep:#ff8579;
  --pom-tint:#331613;
  --pom-line:#7b332d;
  --bone:#11140c;
  --surface:#1a1f13;
  --surface-2:#222719;
  --ink:#eef1e4;
  --ink-2:#c9d0ba;
  --muted:#8e9880;
  --line:#2e3520;
  --line-2:#404830;
  --correct:#9bc44a;
  --correct-tint:#1d2810;
  --correct-line:#425a1c;
  --lens-diagnosis:#7ba3d8;
  --lens-management:#4bb5ae;
  --lens-discriminator:#a98ad4;
  --lens-pitfall:#ff6b60;
  --lens-complication:#dd9a45;
  --lens-calculation:#9aa4b2;
  --shadow-1:0 1px 2px rgba(0,0,0,.45);
  --shadow-2:0 2px 6px rgba(0,0,0,.45),0 12px 32px rgba(0,0,0,.35);
}

*{box-sizing:border-box}
html,body{margin:0;padding:0}
html{-webkit-text-size-adjust:100%}
body{
  background:var(--bone);color:var(--ink);
  font-family:var(--ui);font-size:15px;line-height:1.55;
  -webkit-font-smoothing:antialiased;
}
button,select,input{font:inherit;color:inherit}
h1,h2,h3,h4{margin:0;line-height:1.24;font-weight:650;letter-spacing:-.008em}
p{margin:0 0 10px}p:last-child{margin-bottom:0}
svg{display:block}
.muted{color:var(--muted)}
.eyebrow{
  font-family:var(--ui);font-size:11px;font-weight:750;
  letter-spacing:.12em;text-transform:uppercase;color:var(--acem);
}
:root.dark .eyebrow{color:var(--acem-2)}
:focus-visible{outline:2px solid var(--acem);outline-offset:2px;border-radius:4px}
:root.dark :focus-visible{outline-color:var(--acem-2)}

.ui-icon{width:17px;height:17px;flex:none;fill:none;stroke:currentColor;stroke-width:1.75;stroke-linecap:round;stroke-linejoin:round}
.ui-icon .icon-fill{fill:currentColor;stroke:currentColor}

/* ==================== frame ==================== */
.app{display:grid;grid-template-columns:var(--rail) minmax(0,1fr);min-height:100vh;transition:grid-template-columns .22s ease}

/* ---- collapsible rail ---- */
.rail-toggle{display:inline-flex}
.rail-toggle .chev{transition:transform .22s ease;transform-origin:14px 12px}
.app.rail-collapsed{--rail:64px}
.app.rail-collapsed .rail-toggle .chev{transform:rotate(180deg)}
.app.rail-collapsed .sidebar{padding:20px 9px;align-items:center;overflow-x:hidden}
.app.rail-collapsed .brand{padding:2px 0 18px;justify-content:center}
.app.rail-collapsed .brand>div:last-child,
.app.rail-collapsed .nav button>span:not(.icon),
.app.rail-collapsed .side-label,
.app.rail-collapsed .cat-list,
.app.rail-collapsed .footer-note{display:none}
.app.rail-collapsed .nav{width:100%}
.app.rail-collapsed .nav button{justify-content:center;padding:11px 0;border-left:0;border-radius:9px}
.app.rail-collapsed .nav button.active{background:rgba(255,255,255,.2)}

/* ---- ACEM rail ---- */
.sidebar{
  position:sticky;top:0;height:100vh;overflow:auto;
  background:linear-gradient(178deg,var(--acem) 0%,var(--acem-deep) 100%);
  color:#fff;padding:20px 14px;
  display:flex;flex-direction:column;gap:4px;
  box-shadow:inset -1px 0 0 rgba(255,255,255,.08);
}
:root.dark .sidebar{background:linear-gradient(178deg,#232d0c 0%,#0c1006 100%)}
.brand{display:flex;align-items:center;gap:11px;padding:2px 6px 22px}
.brandmark{
  width:40px;height:40px;flex:none;border-radius:11px;
  background:#fff;color:var(--acem);
  display:grid;place-items:center;
  box-shadow:0 0 0 2px rgba(255,255,255,.22);
}
.brandmark svg{width:22px;height:22px;fill:currentColor;stroke:none}
.brand h1{
  font-family:var(--display);font-size:14.5px;font-weight:600;
  letter-spacing:.005em;color:#fff;
}
.brand small{display:block;font-size:11.5px;color:rgba(255,255,255,.68);margin-top:2px}

.nav{display:flex;flex-direction:column;gap:3px}
.nav button{
  appearance:none;border:0;background:none;cursor:pointer;
  display:flex;align-items:center;gap:11px;width:100%;
  text-align:left;padding:10px 12px;border-radius:9px;
  color:rgba(255,255,255,.82);font-size:14px;font-weight:550;
  border-left:3px solid transparent;transition:background .14s,color .14s;
}
.nav button .icon{display:flex;flex:none}
.nav button:hover{background:rgba(255,255,255,.10);color:#fff}
.nav button.active{background:rgba(255,255,255,.14);color:#fff;border-left-color:#fff;font-weight:650}

.side-label{
  font-size:10.5px;font-weight:750;letter-spacing:.13em;text-transform:uppercase;
  color:rgba(255,255,255,.5);padding:22px 12px 8px;
}
.cat-list{display:flex;flex-direction:column;gap:1px}
.cat-btn{
  appearance:none;border:0;background:none;cursor:pointer;width:100%;
  display:flex;justify-content:space-between;align-items:center;gap:10px;
  padding:7px 12px;border-radius:7px;
  color:rgba(255,255,255,.78);font-size:12.5px;text-align:left;
}
.cat-btn:hover{background:rgba(255,255,255,.10);color:#fff}
.cat-count{font-variant-numeric:tabular-nums;font-size:11.5px;color:rgba(255,255,255,.5)}
.cat-btn:hover .cat-count{color:rgba(255,255,255,.8)}

.footer-note{
  margin-top:auto;padding:18px 12px 4px;
  border-top:1px solid rgba(255,255,255,.16);
  font-size:11px;line-height:1.55;color:rgba(255,255,255,.62);
}
.author-credit{margin-top:5px;color:rgba(255,255,255,.85);font-weight:600}

/* ---- main ---- */
.main{min-width:0;display:flex;flex-direction:column}
.topbar{
  position:sticky;top:0;z-index:30;
  display:flex;align-items:center;justify-content:space-between;gap:16px;
  padding:14px 30px;background:var(--surface);
  border-bottom:1px solid var(--line);
  box-shadow:0 1px 0 rgba(30,36,23,.03);
}
.top-title h2{font-family:var(--display);font-size:20px;font-weight:600}
.top-title p{margin:2px 0 0;font-size:13px;color:var(--muted)}
.top-actions{display:flex;align-items:center;gap:8px}
.mobile-menu{display:none}
.content{padding:26px 30px 70px;max-width:1240px;width:100%;margin:0 auto}
.view{display:none}
.view.active{display:block}

/* ==================== primitives ==================== */
.card{
  background:var(--surface);border:1px solid var(--line);
  border-radius:var(--radius);box-shadow:var(--shadow-1);
}
.button{
  appearance:none;cursor:pointer;
  display:inline-flex;align-items:center;justify-content:center;gap:7px;
  border:1px solid var(--line-2);background:var(--surface);color:var(--ink);
  padding:9px 16px;border-radius:8px;font-size:14px;font-weight:600;
  transition:background .13s,border-color .13s,color .13s;
}
.button:hover{background:var(--surface-2);border-color:var(--muted)}
.button.primary{background:var(--acem);border-color:var(--acem);color:#fff}
.button.primary:hover{background:var(--acem-deep);border-color:var(--acem-deep)}
:root.dark .button.primary{color:#12180a}
:root.dark .button.primary:hover{background:var(--acem-2);border-color:var(--acem-2)}
.button.danger{background:transparent;border-color:var(--pom);color:var(--pom)}
.button.danger:hover{background:var(--pom-tint);border-color:var(--pom)}
.button.ghost{background:transparent;border-color:transparent;color:var(--muted);padding:8px 11px}
.button.ghost:hover{background:var(--surface-2);color:var(--ink)}
.button.icon-only{padding:8px;width:36px}
.button:disabled{opacity:.4;cursor:not-allowed}
.button:disabled:hover{background:var(--surface);border-color:var(--line-2)}
.button.primary:disabled:hover{background:var(--acem);border-color:var(--acem)}
.button.large{padding:11px 20px;font-size:15px}

.pill{
  display:inline-flex;align-items:center;gap:6px;
  padding:4px 11px;border-radius:999px;
  border:1px solid var(--line);background:var(--surface-2);
  font-size:11.5px;font-weight:650;color:var(--ink-2);white-space:nowrap;
}
.pill.category{background:var(--acem-tint);border-color:transparent;color:var(--acem)}
:root.dark .pill.category{color:var(--acem-2)}

/* lens chips — the five reasoning lenses this bank is built from */
.lens{
  display:inline-flex;align-items:center;gap:7px;
  padding:4px 11px 4px 9px;border-radius:999px;
  font-size:11.5px;font-weight:700;letter-spacing:.02em;
  border:1px solid currentColor;background:transparent;
  text-transform:capitalize;white-space:nowrap;
}
.lens::before{content:"";width:7px;height:7px;border-radius:50%;background:currentColor;flex:none}
.lens[data-lens="diagnosis"]{color:var(--lens-diagnosis)}
.lens[data-lens="management"]{color:var(--lens-management)}
.lens[data-lens="discriminator"]{color:var(--lens-discriminator)}
.lens[data-lens="pitfall"]{color:var(--lens-pitfall)}
.lens[data-lens="complication"]{color:var(--lens-complication)}
.lens[data-lens="calculation"]{color:var(--lens-calculation)}

.section-title{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;margin:32px 0 14px}
.section-title h3{font-family:var(--display);font-size:18px;font-weight:600}
.section-title p{margin:4px 0 0;font-size:13.5px;color:var(--muted)}
.row{display:flex;justify-content:space-between;align-items:center;gap:12px}
.field label{display:block;font-size:12px;font-weight:650;color:var(--muted);margin-bottom:6px}
.field select,.field input,.answer-controls select,.answer-controls input{
  width:100%;padding:9px 11px;border-radius:8px;
  background:var(--surface);color:var(--ink);border:1px solid var(--line-2);
}

/* ==================== dashboard ==================== */
.hero{display:grid;grid-template-columns:1.55fr .95fr;gap:16px;margin-bottom:16px}
.hero-main{
  padding:30px 32px;position:relative;overflow:hidden;
  border-top:4px solid var(--acem);
}
.hero-main h3{font-family:var(--display);font-size:29px;font-weight:600;margin:10px 0 12px;max-width:22ch}
.hero-main p{color:var(--ink-2);max-width:60ch;line-height:1.65;font-size:14.5px}
.hero-main .hero-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}
.hero-side{
  padding:26px;display:flex;flex-direction:column;justify-content:center;gap:5px;
  border-top:4px solid var(--pom);
}
.big-number{
  font-family:var(--display);font-size:44px;font-weight:600;
  line-height:1;letter-spacing:-.02em;font-variant-numeric:tabular-nums;
}
.session-note{
  margin-top:18px;padding-top:15px;border-top:1px solid var(--line);
  display:flex;flex-direction:column;gap:4px;font-size:12.5px;color:var(--muted);
}
.session-note strong{color:var(--ink-2);font-size:13px}

.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
.stat{padding:17px 19px}
.stat .muted{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
.stat .n{font-family:var(--display);font-size:27px;font-weight:600;margin-top:5px;font-variant-numeric:tabular-nums}

.category-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.category-card{
  padding:16px 18px;cursor:pointer;
  border-left:3px solid transparent;
  transition:border-color .14s,box-shadow .14s,transform .14s;
}
.category-card:hover{border-left-color:var(--acem);box-shadow:var(--shadow-2);transform:translateY(-1px)}
.category-card h4{font-size:14.5px}
.category-card .row strong{font-family:var(--display);color:var(--acem);font-size:17px;font-variant-numeric:tabular-nums}
:root.dark .category-card .row strong{color:var(--acem-2)}

/* ==================== exam setup ==================== */
.setup{padding:26px 28px;max-width:1000px}
.form-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:13px}
.form-grid .field:first-child{grid-column:span 2}
.setup-actions{margin-top:20px;display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.setup-hint{margin-top:16px;font-size:12.5px;color:var(--muted)}
kbd{
  font:inherit;font-size:11px;font-weight:700;
  padding:1px 6px;border-radius:5px;margin:0 1px;
  background:var(--surface-2);border:1px solid var(--line-2);
  box-shadow:0 1px 0 var(--line-2);
}

/* ==================== exam runner ==================== */
.quiz-shell{display:none}
.quiz-shell.active{display:block}

.quiz-head{
  position:sticky;top:63px;z-index:20;
  display:flex;align-items:center;gap:14px;flex-wrap:wrap;
  padding:12px 18px;background:var(--surface);
  border:1px solid var(--line);border-bottom:0;
  border-radius:var(--radius) var(--radius) 0 0;
}
.quiz-meta{display:flex;gap:7px;flex-wrap:wrap;align-items:center}
.quiz-head .muted{
  margin-left:auto;display:flex;align-items:center;gap:14px;
  font-size:13px;font-variant-numeric:tabular-nums;
}
#qPosition{font-weight:700;color:var(--ink-2)}
#timer{
  display:inline-block;padding:3px 10px;border-radius:6px;
  background:var(--surface-2);border:1px solid var(--line);
  font-weight:700;color:var(--ink-2);
}
.session-strip{
  height:4px;background:var(--line);overflow:hidden;
  border-left:1px solid var(--line);border-right:1px solid var(--line);
}
.session-strip>span{display:block;height:100%;background:var(--acem);transition:width .25s ease}
:root.dark .session-strip>span{background:var(--acem-2)}

.quiz-workspace{display:grid;grid-template-columns:minmax(0,1fr) 224px;gap:20px;align-items:start;margin-top:20px}
.quiz-main-column{min-width:0;display:flex;flex-direction:column;gap:16px;max-width:820px;justify-self:center;width:100%}

.question-card{padding:28px 34px}
.question-card>.row{padding-bottom:15px;margin-bottom:20px;border-bottom:1px solid var(--line)}
#qNumber{font-size:11.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
.question-controls{display:flex;gap:4px}
.question-controls .button{padding:6px 11px;font-size:12.5px}
#bookmarkBtn[aria-pressed="true"]{color:var(--acem);background:var(--acem-tint)}
:root.dark #bookmarkBtn[aria-pressed="true"]{color:var(--acem-2)}
#flagBtn[aria-pressed="true"],#flagBtn.flag-active{color:var(--pom);background:var(--pom-tint)}

#qStem{
  font-size:17.5px;line-height:1.68;font-weight:420;
  color:var(--ink);margin:0 0 24px;max-width:68ch;letter-spacing:0;
}
.choice-label{font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:10px}

.option-list{display:flex;flex-direction:column;gap:8px}
.option{
  appearance:none;cursor:pointer;width:100%;text-align:left;
  display:grid;grid-template-columns:28px minmax(0,1fr);align-items:flex-start;gap:14px;
  padding:13px 16px;border-radius:var(--radius-sm);
  border:1px solid var(--line-2);background:var(--surface);color:var(--ink);
  font-size:14.5px;line-height:1.5;
  transition:border-color .12s,background .12s,box-shadow .12s;
}
.option:hover:not(:disabled){border-color:var(--acem);background:var(--acem-tint)}
.option .letter{
  width:26px;height:26px;border-radius:50%;flex:none;
  display:grid;place-items:center;
  border:1.5px solid var(--line-2);background:var(--surface);
  font-size:12.5px;font-weight:750;color:var(--muted);transition:all .12s;
}
.option:hover:not(:disabled) .letter{border-color:var(--acem);color:var(--acem)}
.option.selected{border-color:var(--acem);background:var(--acem-tint);box-shadow:inset 0 0 0 1px var(--acem)}
.option.selected .letter{background:var(--acem);border-color:var(--acem);color:#fff}
.option.correct{border-color:var(--correct-line);background:var(--correct-tint);box-shadow:inset 0 0 0 1px var(--correct-line)}
.option.correct .letter{background:var(--correct);border-color:var(--correct);color:#fff}
.option.incorrect{border-color:var(--pom-line);background:var(--pom-tint);box-shadow:inset 0 0 0 1px var(--pom-line)}
.option.incorrect .letter{background:var(--pom);border-color:var(--pom);color:#fff}
.option:disabled{cursor:default}
.option:disabled:not(.correct):not(.incorrect){opacity:.55}

.quiz-actions{
  display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;
  padding:15px 20px;border-radius:var(--radius);
  background:var(--surface);border:1px solid var(--line);box-shadow:var(--shadow-1);
}
.quiz-actions .group{display:flex;gap:9px;flex-wrap:wrap}

/* ==================== explanation ==================== */
.feedback{display:none}
.feedback.show{display:block;margin-top:26px;padding-top:24px;border-top:1px solid var(--line);animation:rise .2s ease}
@keyframes rise{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}

.verdict{
  display:flex;align-items:center;gap:13px;
  padding:14px 18px;border-radius:var(--radius-sm);margin-bottom:22px;
  border:1px solid transparent;
}
.verdict-icon{
  width:30px;height:30px;border-radius:50%;flex:none;
  display:grid;place-items:center;color:#fff;
}
.verdict-icon svg{width:17px;height:17px;stroke-width:2.6}
.verdict strong{display:block;font-size:15.5px}
.verdict .sub{display:block;font-size:13px;color:var(--muted);margin-top:1px}
.feedback.good .verdict{background:var(--correct-tint);border-color:var(--correct-line)}
.feedback.good .verdict-icon{background:var(--correct)}
.feedback.good .verdict strong{color:var(--correct)}
.feedback.bad .verdict{background:var(--pom-tint);border-color:var(--pom-line)}
.feedback.bad .verdict-icon{background:var(--pom)}
.feedback.bad .verdict strong{color:var(--pom)}

.explain-block{margin-bottom:22px}
.explain-block h4{font-size:11px;font-weight:750;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:9px}
.explain-block p{font-size:15px;line-height:1.68;color:var(--ink-2)}
.correct-line{
  font-size:15px;font-weight:650;color:var(--ink);
  padding:12px 15px;border-radius:var(--radius-sm);
  background:var(--correct-tint);border-left:3px solid var(--correct);
}
.rapid-review{border:1px solid var(--line);border-radius:var(--radius-sm);overflow:hidden;background:var(--surface-2)}
.rapid-review-head{
  background:var(--acem);color:#fff;padding:9px 16px;
  font-size:11px;font-weight:750;letter-spacing:.1em;text-transform:uppercase;
}
:root.dark .rapid-review-head{color:#12180a}
.rapid-review-body{padding:15px 17px;font-size:14.5px;line-height:1.62;color:var(--ink-2)}

/* ==================== navigator ==================== */
.question-navigator{padding:17px;position:sticky;top:145px}
.question-navigator-title{font-size:11px;font-weight:750;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
.question-navigator-summary{font-size:12.5px;margin:5px 0 13px}
.question-number-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:5px;max-height:290px;overflow:auto}
.qnav-button{
  position:relative;appearance:none;cursor:pointer;aspect-ratio:1;
  border-radius:7px;border:1px solid var(--line-2);background:var(--surface);
  color:var(--ink-2);font-size:12px;font-weight:700;
  display:grid;place-items:center;font-variant-numeric:tabular-nums;
}
.qnav-button:hover{border-color:var(--acem);color:var(--acem)}
.qnav-button.answered{background:var(--surface-2);border-color:var(--muted);color:var(--ink)}
.qnav-button.correct{background:var(--correct-tint);border-color:var(--correct-line);color:var(--correct)}
.qnav-button.incorrect{background:var(--pom-tint);border-color:var(--pom-line);color:var(--pom)}
.qnav-button.flagged{border-color:var(--pom);box-shadow:inset 0 0 0 1px var(--pom)}
.qnav-button.current{background:var(--acem);border-color:var(--acem);color:#fff}
:root.dark .qnav-button.current{color:#12180a}
.flag-dot{position:absolute;top:-4px;right:-4px;color:var(--pom);line-height:0}
.flag-dot svg{width:11px;height:11px;stroke-width:2.2}
.question-nav-legend{
  display:flex;flex-direction:column;gap:7px;margin-top:15px;padding-top:13px;
  border-top:1px solid var(--line);font-size:11.5px;color:var(--muted);
}
.question-nav-legend span{display:flex;align-items:center;gap:8px}
.legend-swatch{width:11px;height:11px;border-radius:3px;border:1px solid var(--line-2);display:inline-block;flex:none}
.legend-swatch.current{background:var(--acem);border-color:var(--acem)}
.legend-swatch.answered{background:var(--surface-2);border-color:var(--muted)}
.legend-swatch.flagged{border-color:var(--pom);background:var(--pom-tint)}

/* ==================== results ==================== */
.results{display:none}
.results.active{display:block}
.results-summary{
  display:flex;align-items:center;gap:30px;flex-wrap:wrap;
  padding:28px 32px;margin-bottom:20px;
  background:var(--surface);border:1px solid var(--line);
  border-top:4px solid var(--acem);
  border-radius:var(--radius);box-shadow:var(--shadow-1);
}
.score-ring{
  width:116px;height:116px;border-radius:50%;flex:none;display:grid;place-items:center;
  background:conic-gradient(var(--acem) var(--score),var(--line) 0);
}
:root.dark .score-ring{background:conic-gradient(var(--acem-2) var(--score),var(--line) 0)}
.score-ring strong{
  width:92px;height:92px;border-radius:50%;background:var(--surface);
  display:grid;place-items:center;
  font-family:var(--display);font-size:25px;font-weight:600;font-variant-numeric:tabular-nums;
}
.results-summary h2{font-family:var(--display);font-size:23px;font-weight:600;margin:6px 0 4px}
.result-toolbar{display:flex;gap:8px;flex-wrap:wrap;margin-top:18px}

/* performance bars */
.perf-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:22px}
.perf-card{padding:20px 22px}
.perf-card h3{font-size:14px;margin-bottom:3px}
.perf-card>p{font-size:12.5px;color:var(--muted);margin-bottom:16px}
.perf-row{display:grid;grid-template-columns:minmax(90px,34%) 1fr auto;align-items:center;gap:12px;margin-bottom:10px}
.perf-row:last-child{margin-bottom:0}
.perf-name{font-size:12.5px;font-weight:600;color:var(--ink-2);text-transform:capitalize;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.perf-track{height:8px;border-radius:999px;background:var(--line);overflow:hidden}
.perf-fill{display:block;height:100%;border-radius:999px;background:var(--acem)}
.perf-fill.low{background:var(--pom)}
.perf-fill.mid{background:var(--lens-complication)}
.perf-score{font-size:12px;font-weight:700;color:var(--muted);font-variant-numeric:tabular-nums;min-width:52px;text-align:right}

.result-breakdown-heading{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap;margin-bottom:14px}
.result-breakdown-heading h2{font-family:var(--display);font-size:18px;font-weight:600}
.result-breakdown-heading p{margin:4px 0 0;font-size:13px;color:var(--muted)}
.result-filter-group{display:flex;gap:6px;flex-wrap:wrap}
.result-filter{padding:7px 13px;font-size:13px}
.result-filter.active{background:var(--acem);border-color:var(--acem);color:#fff}
:root.dark .result-filter.active{color:#12180a}
.result-review-list{display:flex;flex-direction:column;gap:10px}
.result-question{
  background:var(--surface);border:1px solid var(--line);
  border-left:3px solid var(--line-2);border-radius:var(--radius-sm);
  box-shadow:var(--shadow-1);overflow:hidden;
}
.result-question.correct{border-left-color:var(--correct)}
.result-question.incorrect{border-left-color:var(--pom)}
.result-question.unanswered{border-left-color:var(--lens-complication)}
.result-question summary{
  cursor:pointer;list-style:none;display:flex;align-items:center;gap:12px;flex-wrap:wrap;
  padding:13px 18px;font-size:13.5px;
}
.result-question summary::-webkit-details-marker{display:none}
.result-question summary:hover{background:var(--surface-2)}
.result-question-number{font-weight:700}
.result-question-category{color:var(--muted);font-size:12.5px}
.result-status{margin-left:auto;padding:3px 11px;border-radius:999px;font-size:11.5px;font-weight:700}
.result-status.correct{background:var(--correct-tint);color:var(--correct)}
.result-status.incorrect{background:var(--pom-tint);color:var(--pom)}
.result-status.unanswered{background:var(--surface-2);color:var(--lens-complication)}
.result-question-body{padding:4px 20px 22px;border-top:1px solid var(--line)}
.result-question-body h3{font-size:16px;font-weight:420;line-height:1.62;margin:18px 0;max-width:70ch}
.result-answer-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:18px}
.result-answer{padding:12px 15px;border-radius:var(--radius-sm);background:var(--surface-2);border:1px solid var(--line)}
.result-answer span{display:block;font-size:11px;font-weight:750;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:4px}
.result-answer strong{font-size:14px;font-weight:600;line-height:1.45}
.result-answer.correct-answer{background:var(--correct-tint);border-color:var(--correct-line)}
.result-answer.correct-answer strong{color:var(--correct)}
.result-explanation h4{font-size:11px;font-weight:750;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:8px}
.result-explanation p{font-size:14.5px;line-height:1.65;color:var(--ink-2)}
.result-learning-point{
  margin-top:13px;padding:12px 15px;border-radius:var(--radius-sm);
  background:var(--acem-tint);border-left:3px solid var(--acem);
  font-size:14px;color:var(--ink-2);
}

/* ==================== answer key ==================== */
.answer-controls{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:16px}
.answer-controls select{max-width:330px}
.answer-controls input{flex:1;min-width:210px}
.answer-group h3{font-size:13.5px;font-weight:650;color:var(--muted);margin-bottom:11px}
.answer-item{margin-bottom:8px;overflow:hidden}
.answer-item summary{cursor:pointer;list-style:none;display:flex;gap:10px;padding:13px 18px;font-size:14.5px;line-height:1.5}
.answer-item summary::-webkit-details-marker{display:none}
.answer-item summary::before{content:"›";color:var(--acem);font-size:17px;line-height:1.2;flex:none;transition:transform .15s}
.answer-item[open] summary::before{transform:rotate(90deg)}
.answer-item summary:hover{background:var(--surface-2)}
.answer-body{padding:2px 18px 20px;border-top:1px solid var(--line)}
.mini-options{margin:15px 0;padding-left:22px;font-size:14px;color:var(--ink-2)}
.mini-options li{margin-bottom:5px;line-height:1.5}
.answer-body .answer{
  font-weight:650;color:var(--correct);font-size:14.5px;margin-bottom:13px;
  padding:11px 14px;border-radius:var(--radius-sm);
  background:var(--correct-tint);border-left:3px solid var(--correct);
}
.answer-body p{font-size:14.5px;line-height:1.62;color:var(--ink-2)}
.empty{padding:34px;text-align:center;color:var(--muted)}

/* ==================== saved ==================== */
.review-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
.review-card{padding:23px 25px}
.review-card h3{font-size:16px;margin-bottom:6px}
.review-card p{font-size:13.5px;margin-bottom:15px}
.review-card .big-number{margin-bottom:15px;color:var(--acem)}
:root.dark .review-card .big-number{color:var(--acem-2)}
#referenceList ol{margin:13px 0 0;padding-left:20px;font-size:13.5px;color:var(--ink-2)}
#referenceList li{margin-bottom:7px;line-height:1.55}
#referenceList p{font-size:13.5px;color:var(--muted)}

/* ==================== toast ==================== */
.toast{
  position:fixed;left:50%;bottom:26px;transform:translate(-50%,14px);
  background:var(--ink);color:var(--bone);
  padding:11px 19px;border-radius:9px;font-size:13.5px;font-weight:600;
  opacity:0;pointer-events:none;transition:.18s;z-index:90;box-shadow:var(--shadow-2);
}
.toast.show{opacity:1;transform:translate(-50%,0)}

/* ==================== responsive ==================== */
@media (max-width:1180px){
  .quiz-workspace{grid-template-columns:1fr}
  .question-navigator{position:static;order:2}
  .question-number-grid{grid-template-columns:repeat(10,1fr);max-height:none}
  .question-nav-legend{flex-direction:row;gap:18px}
  .perf-grid{grid-template-columns:1fr}
}
@media (max-width:980px){
  .hero{grid-template-columns:1fr}
  .grid{grid-template-columns:repeat(2,1fr)}
  .category-grid{grid-template-columns:repeat(2,1fr)}
  .review-grid{grid-template-columns:1fr}
  .form-grid{grid-template-columns:1fr 1fr}
  .form-grid .field:first-child{grid-column:span 2}
  .result-answer-grid{grid-template-columns:1fr}
}
@media (max-width:760px){
  .app,.app.rail-collapsed{grid-template-columns:1fr;--rail:270px}
  .rail-toggle{display:none}
  .app.rail-collapsed .sidebar{padding:20px 13px;align-items:stretch;overflow-x:auto}
  .app.rail-collapsed .brand{padding:2px 6px 20px;justify-content:flex-start}
  .app.rail-collapsed .brand>div:last-child,
  .app.rail-collapsed .nav button>span:not(.icon),
  .app.rail-collapsed .side-label,
  .app.rail-collapsed .cat-list,
  .app.rail-collapsed .footer-note{display:revert}
  .app.rail-collapsed .nav button{justify-content:flex-start;padding:10px 12px;border-left:3px solid transparent}
  .sidebar{
    position:fixed;left:0;top:0;bottom:0;width:270px;z-index:60;
    transform:translateX(-100%);transition:transform .2s ease;
  }
  .sidebar.open{transform:none;box-shadow:var(--shadow-2)}
  .mobile-menu{display:inline-flex}
  .topbar{padding:12px 16px}
  .content{padding:20px 16px 60px}
  .question-card{padding:22px 18px}
  #qStem{font-size:16.5px}
  .quiz-head{top:59px;padding:11px 14px}
  .quiz-actions{padding:13px 14px}
  .quiz-actions .group{flex:1}
  .quiz-actions .button{flex:1}
  .grid{grid-template-columns:1fr 1fr}
  .category-grid,.form-grid{grid-template-columns:1fr}
  .form-grid .field:first-child{grid-column:auto}
  .hero-main{padding:24px 20px}
  .hero-main h3{font-size:23px}
  .results-summary{padding:22px;gap:20px}
}

@media (prefers-reduced-motion:reduce){
  *{animation:none!important;transition:none!important;scroll-behavior:auto!important}
}

@media print{
  .sidebar,.topbar,.quiz-head,.session-strip,.question-navigator,
  .quiz-actions,.result-toolbar,.result-filter-group,.toast{display:none!important}
  .app{grid-template-columns:1fr}
  body{background:#fff}
  .card,.result-question,.results-summary,.perf-card{box-shadow:none;border-color:#ccc}
  .result-question{break-inside:avoid}
}

/* ==================== progress · categories · dashboard panel ==================== */

/* --- KPI strip --- */
.kpi-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:12px}
.kpi{padding:15px 17px;border-top:3px solid var(--line-2)}
.kpi.is-acem{border-top-color:var(--acem)}
.kpi.is-pom{border-top-color:var(--pom)}
.kpi.is-correct{border-top-color:var(--correct)}
.kpi.is-warn{border-top-color:var(--lens-complication)}
.kpi .k-label{font-size:10.5px;font-weight:750;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
.kpi .k-value{font-family:var(--display);font-size:26px;font-weight:600;line-height:1.05;margin-top:7px;font-variant-numeric:tabular-nums;letter-spacing:-.015em}
.kpi .k-value small{font-family:var(--ui);font-size:13px;font-weight:600;color:var(--muted);letter-spacing:0}
.kpi .k-sub{font-size:11.5px;color:var(--muted);margin-top:5px;line-height:1.45}

/* --- panels --- */
.panel{padding:20px 22px}
.panel-head{display:flex;justify-content:space-between;align-items:flex-end;gap:14px;margin-bottom:16px;flex-wrap:wrap}
.panel-head h3{font-family:var(--display);font-size:16px;font-weight:600}
.panel-head p{margin:3px 0 0;font-size:12.5px;color:var(--muted)}
.panel-head .panel-actions{display:flex;gap:6px;flex-wrap:wrap}
.panel-head .panel-actions .button{padding:6px 12px;font-size:12.5px}

.split-2{display:grid;grid-template-columns:300px minmax(0,1fr);gap:14px;margin-bottom:14px}
.split-even{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-bottom:14px}

/* --- donut --- */
.donut-wrap{display:flex;flex-direction:column;align-items:center;gap:14px}
.donut{position:relative;width:158px;height:158px}
.donut svg{width:100%;height:100%;transform:rotate(-90deg)}
.donut .donut-track{fill:none;stroke:var(--line);stroke-width:13}
.donut .donut-arc{fill:none;stroke:var(--acem);stroke-width:13;stroke-linecap:round;transition:stroke-dasharray .5s ease}
:root.dark .donut .donut-arc{stroke:var(--acem-2)}
.donut-centre{position:absolute;inset:0;display:grid;place-items:center;text-align:center}
.donut-centre strong{display:block;font-family:var(--display);font-size:28px;font-weight:600;line-height:1;font-variant-numeric:tabular-nums}
.donut-centre span{display:block;font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--muted);margin-top:5px}

/* --- mastery stack --- */
.mastery-bar{display:flex;height:12px;border-radius:999px;overflow:hidden;background:var(--line);margin-bottom:13px}
.mastery-bar span{display:block;height:100%}
.mastery-legend{display:flex;flex-direction:column;gap:8px}
.mastery-legend div{display:flex;align-items:center;gap:9px;font-size:12.5px;color:var(--ink-2)}
.mastery-legend i{width:10px;height:10px;border-radius:3px;flex:none}
.mastery-legend b{margin-left:auto;font-variant-numeric:tabular-nums;font-weight:700;color:var(--ink)}
.sw-strong{background:var(--correct)}
.sw-fair{background:var(--lens-complication)}
.sw-weak{background:var(--pom)}
.sw-unseen{background:var(--line-2)}

/* --- charts --- */
.chart-frame{width:100%;overflow:hidden}
.chart-frame svg{width:100%;height:auto;display:block}
.chart-grid-line{stroke:var(--line);stroke-width:1}
.chart-axis-text{fill:var(--muted);font-size:10.5px;font-family:var(--ui);font-weight:650}
.chart-area{fill:var(--acem);opacity:.11}
:root.dark .chart-area{fill:var(--acem-2);opacity:.16}
.chart-line{fill:none;stroke:var(--acem);stroke-width:2.25;stroke-linejoin:round;stroke-linecap:round}
:root.dark .chart-line{stroke:var(--acem-2)}
.chart-dot{fill:var(--surface);stroke:var(--acem);stroke-width:2.25}
:root.dark .chart-dot{stroke:var(--acem-2)}
.chart-dot-hit{fill:transparent;cursor:pointer}
.chart-mean{stroke:var(--pom);stroke-width:1.4;stroke-dasharray:5 4;opacity:.8}
.chart-empty{padding:44px 20px;text-align:center;color:var(--muted);font-size:13.5px}

/* lens columns */
.lens-cols{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px;align-items:end}
.lens-col{display:flex;flex-direction:column;align-items:center;gap:9px;min-width:0}
.lens-col .lc-track{width:100%;height:132px;border-radius:8px 8px 4px 4px;background:var(--surface-2);border:1px solid var(--line);display:flex;align-items:flex-end;overflow:hidden}
.lens-col .lc-fill{width:100%;background:currentColor;border-radius:6px 6px 0 0;transition:height .45s ease;min-height:3px}
.lens-col .lc-pct{font-size:13px;font-weight:750;font-variant-numeric:tabular-nums;color:currentColor}
.lens-col .lc-name{font-size:11px;font-weight:650;color:var(--ink-2);text-align:center;line-height:1.3}
.lens-col .lc-n{font-size:10.5px;color:var(--muted);font-variant-numeric:tabular-nums}
.lens-col.dim{opacity:.42}
.lens-col[data-lens="diagnosis"]{color:var(--lens-diagnosis)}
.lens-col[data-lens="management"]{color:var(--lens-management)}
.lens-col[data-lens="discriminator"]{color:var(--lens-discriminator)}
.lens-col[data-lens="pitfall"]{color:var(--lens-pitfall)}
.lens-col[data-lens="complication"]{color:var(--lens-complication)}
.lens-col[data-lens="calculation"]{color:var(--lens-calculation)}

/* --- activity heatmap --- */
.heat{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(0,1fr);gap:3px}
.heat-col{display:grid;grid-template-rows:repeat(7,1fr);gap:3px}
.heat-cell{width:100%;aspect-ratio:1;border-radius:3px;background:var(--surface-2);border:1px solid var(--line)}
.heat-cell.l1{background:var(--acem-tint);border-color:transparent}
.heat-cell.l2{background:color-mix(in srgb,var(--acem) 38%,var(--acem-tint));border-color:transparent}
.heat-cell.l3{background:color-mix(in srgb,var(--acem) 68%,var(--acem-tint));border-color:transparent}
.heat-cell.l4{background:var(--acem);border-color:transparent}
.heat-cell.future{opacity:0;pointer-events:none}
.heat-foot{display:flex;align-items:center;gap:8px;margin-top:12px;font-size:11.5px;color:var(--muted)}
.heat-foot .heat-cell{width:11px;height:11px;aspect-ratio:auto;flex:none}
.heat-months{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(0,1fr);gap:3px;margin-bottom:6px;font-size:10px;color:var(--muted);font-weight:700;letter-spacing:.04em}
.heat-months span{white-space:nowrap;overflow:visible}

/* --- category performance rows --- */
.perf-row.linked{cursor:pointer;padding:5px 7px;margin:0 -7px 4px;border-radius:7px}
.perf-row.linked:hover{background:var(--surface-2)}
.perf-row .perf-cover{font-size:11px;color:var(--muted);font-variant-numeric:tabular-nums;min-width:78px;text-align:right}
.perf-scroll{max-height:520px;overflow-y:auto;padding-right:4px}
.perf-legend{display:flex;gap:16px;flex-wrap:wrap;font-size:11.5px;color:var(--muted);margin-top:14px;padding-top:12px;border-top:1px solid var(--line)}
.perf-legend span{display:flex;align-items:center;gap:7px}
.perf-legend i{width:10px;height:10px;border-radius:3px;flex:none}

/* --- improvement cards --- */
.focus-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.focus-card{padding:17px 19px;display:flex;flex-direction:column;gap:9px;border-left:3px solid var(--pom)}
.focus-card.tone-warn{border-left-color:var(--lens-complication)}
.focus-card.tone-info{border-left-color:var(--lens-diagnosis)}
.focus-card.tone-good{border-left-color:var(--correct)}
.focus-card .f-rank{font-size:10.5px;font-weight:750;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
.focus-card h4{font-size:15px;line-height:1.3}
.focus-card .f-metric{display:flex;align-items:baseline;gap:8px}
.focus-card .f-metric strong{font-family:var(--display);font-size:23px;font-weight:600;font-variant-numeric:tabular-nums;color:var(--pom)}
.focus-card.tone-warn .f-metric strong{color:var(--lens-complication)}
.focus-card.tone-info .f-metric strong{color:var(--lens-diagnosis)}
.focus-card.tone-good .f-metric strong{color:var(--correct)}
.focus-card .f-metric span{font-size:12px;color:var(--muted)}
.focus-card p{font-size:12.5px;color:var(--muted);line-height:1.5}
.focus-card .button{margin-top:auto;align-self:flex-start;padding:7px 13px;font-size:12.5px}

/* --- session history table --- */
.hist-table{width:100%;border-collapse:collapse;font-size:13px}
.hist-table th{
  text-align:left;font-size:10.5px;font-weight:750;letter-spacing:.09em;text-transform:uppercase;
  color:var(--muted);padding:0 10px 9px;border-bottom:1px solid var(--line);white-space:nowrap;
}
.hist-table td{padding:11px 10px;border-bottom:1px solid var(--line);vertical-align:middle}
.hist-table tr:last-child td{border-bottom:0}
.hist-table td.num{font-variant-numeric:tabular-nums;text-align:right;white-space:nowrap}
.hist-table .h-date{color:var(--ink-2);font-weight:600;white-space:nowrap}
.hist-table .h-scope{color:var(--muted);font-size:12.5px}
.score-chip{
  display:inline-flex;align-items:center;justify-content:center;min-width:52px;
  padding:3px 10px;border-radius:999px;font-size:12px;font-weight:750;font-variant-numeric:tabular-nums;
  background:var(--correct-tint);color:var(--correct);
}
.score-chip.mid{background:var(--pom-tint);color:var(--lens-complication)}
.score-chip.low{background:var(--pom-tint);color:var(--pom)}
.hist-scroll{max-height:400px;overflow-y:auto}

/* --- dashboard slim progress --- */
.dash-progress{display:grid;grid-template-columns:264px minmax(0,1fr);gap:14px}
.dash-ring{padding:22px;display:flex;flex-direction:column;align-items:center;gap:16px;border-top:3px solid var(--acem)}
.dash-ring .dr-stats{display:flex;flex-direction:column;gap:9px;width:100%;padding-top:15px;border-top:1px solid var(--line)}
.dash-ring .dr-stats div{display:flex;justify-content:space-between;align-items:baseline;gap:10px;font-size:12.5px;color:var(--muted)}
.dash-ring .dr-stats b{font-size:14px;font-weight:700;color:var(--ink);font-variant-numeric:tabular-nums}
.dash-chart{padding:20px 22px;display:flex;flex-direction:column}
.dash-focus{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px;padding-top:14px;border-top:1px solid var(--line)}
.focus-pill{
  display:inline-flex;align-items:center;gap:8px;padding:6px 12px;border-radius:999px;cursor:pointer;
  border:1px solid var(--pom-line);background:var(--pom-tint);color:var(--pom);
  font-size:12px;font-weight:650;
}
.focus-pill:hover{border-color:var(--pom)}
.focus-pill b{font-variant-numeric:tabular-nums}
.focus-pill.neutral{border-color:var(--line-2);background:var(--surface-2);color:var(--ink-2)}

/* --- categories page --- */
.cat-toolbar{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:16px}
.cat-toolbar input{flex:1;min-width:210px;padding:9px 12px;border-radius:8px;background:var(--surface);color:var(--ink);border:1px solid var(--line-2)}
.cat-toolbar select{width:auto;min-width:190px;padding:9px 12px;border-radius:8px;background:var(--surface);color:var(--ink);border:1px solid var(--line-2)}
.cat-summary{font-size:12.5px;color:var(--muted);margin-left:auto}

.category-card{display:flex;flex-direction:column;gap:11px;padding:17px 19px}
.category-card .cc-top{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}
.category-card h4{font-size:14.5px;line-height:1.3}
.category-card .cc-count{font-size:11.5px;color:var(--muted);font-variant-numeric:tabular-nums;white-space:nowrap}
.category-card .cc-track{height:7px;border-radius:999px;background:var(--line);overflow:hidden}
.category-card .cc-fill{display:block;height:100%;border-radius:999px;background:var(--acem)}
:root.dark .category-card .cc-fill{background:var(--acem-2)}
.category-card .cc-meta{display:flex;justify-content:space-between;align-items:center;gap:10px;font-size:12px;color:var(--muted)}
.category-card .cc-acc{font-weight:750;font-variant-numeric:tabular-nums;color:var(--correct)}
.category-card .cc-acc.mid{color:var(--lens-complication)}
.category-card .cc-acc.low{color:var(--pom)}
.category-card .cc-acc.none{color:var(--muted);font-weight:600}
.category-card .cc-actions{display:flex;gap:7px;margin-top:2px}
.category-card .cc-actions .button{padding:6px 12px;font-size:12.5px}
.category-card:hover{border-left-color:var(--acem);box-shadow:var(--shadow-2);transform:translateY(-1px)}

/* --- shared bits --- */
.empty-state{padding:46px 30px;text-align:center}
.empty-state h3{font-family:var(--display);font-size:19px;font-weight:600;margin-bottom:8px}
.empty-state p{font-size:13.5px;color:var(--muted);max-width:52ch;margin:0 auto 18px}
.tiny-note{font-size:12px;color:var(--muted);margin-top:12px}
.stat.clickable{cursor:pointer}
.stat.clickable:hover{border-color:var(--muted)}

@media (max-width:1180px){
  .kpi-grid{grid-template-columns:repeat(3,minmax(0,1fr))}
  .split-2{grid-template-columns:1fr}
  .focus-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .dash-progress{grid-template-columns:1fr}
}
@media (max-width:980px){
  .split-even{grid-template-columns:1fr}
  .lens-cols{grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
}
@media (max-width:760px){
  .kpi-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .focus-grid{grid-template-columns:1fr}
  .panel{padding:17px 16px}
  .cat-summary{margin-left:0;width:100%}
  .hist-table th:nth-child(3),.hist-table td:nth-child(3){display:none}
}

.disclaimer-panel{margin-bottom:16px}
.disclaimer-panel h3{font-size:15px;margin:0 0 10px}
.disclaimer-panel p{font-size:14px;line-height:1.62;color:var(--ink-2);margin:0 0 10px}
.disclaimer-panel p:last-child{margin-bottom:0}

/* --- exam lock modal --- */
.modal-backdrop{position:fixed;inset:0;background:rgba(15,18,10,.55);backdrop-filter:blur(2px);
  display:none;align-items:center;justify-content:center;z-index:9000;padding:20px}
.modal-backdrop.open{display:flex}
.modal-card{background:var(--surface);color:var(--ink);border:1px solid var(--line-2);
  border-radius:14px;max-width:460px;width:100%;padding:22px;box-shadow:0 20px 60px rgba(0,0,0,.3)}
.modal-card h3{margin:0 0 8px;font-size:18px}
.modal-card p{margin:0 0 6px;font-size:14px;color:var(--muted);line-height:1.5}
.modal-actions{display:flex;gap:10px;justify-content:flex-end;margin-top:18px;flex-wrap:wrap}
/* --- timer --- */
.timer-wrap{display:inline-flex;align-items:center;gap:7px;margin-left:12px}
.timer-label{font-size:11px;font-weight:650;letter-spacing:.04em;text-transform:uppercase;color:var(--muted)}
#timer{font-variant-numeric:tabular-nums;font-weight:650}
#timer.countdown-warn{color:#b8860b}
#timer.countdown-critical{color:var(--acem-red,#EE3129);animation:timerPulse 1s ease-in-out infinite}
@keyframes timerPulse{50%{opacity:.45}}
/* --- setup hints --- */
.field-hint{font-size:11.5px;color:var(--muted);margin-top:5px;line-height:1.4}
.field-hint.warn{color:var(--acem-red,#EE3129)}
.result-note{font-size:13px;color:var(--muted);margin-top:10px;line-height:1.5}

</style>
<style id="studio-theme">
:root{--acem:#435608;--acem-2:#5d6e2b;--acem-deep:#344306;--acem-tint:#eaece4;--pom:#ee3129;--pom-tint:#fdecec;--pom-line:#f9b9b6;--bone:#f2f3ea;--surface:#ffffff;--surface-2:#f7f7f7;--ink:#1e2417;--ink-2:#424a39;--muted:#6d7862;--line:#dde0ce;--line-2:#c2c5b5;--correct:#4a7710;--correct-tint:#ebf0e5;--correct-line:#bacba4;--display:Optima,Candara,"Gill Sans MT","Gill Sans","Trebuchet MS",var(--ui)}
:root.dark{--acem:#8aa42c;--acem-2:#9ab14a;--acem-deep:#6c8022;--acem-tint:#262e16;--pom:#ff6b60;--pom-tint:#2f261a;--pom-line:#68392d;--bone:#11140c;--surface:#1a1f13;--surface-2:#21261a;--ink:#eef1e4;--ink-2:#c3c9b7;--muted:#8e9880;--line:#2e3520;--line-2:#282f1c;--correct:#9bc44a;--correct-tint:#283119;--correct-line:#4b5e28}
</style>
<style id="pwa-shell">
/* ============================================================
   Installed-app shell: safe areas, drawer backdrop, install cue
   ============================================================ */
:root{
  --safe-top:env(safe-area-inset-top,0px);
  --safe-bottom:env(safe-area-inset-bottom,0px);
  --safe-left:env(safe-area-inset-left,0px);
  --safe-right:env(safe-area-inset-right,0px);
}
html{background:var(--acem-deep)}
body{
  overscroll-behavior-y:contain;
  -webkit-tap-highlight-color:transparent;
  -webkit-touch-callout:none;
}
input,textarea,select{-webkit-user-select:auto;user-select:auto}

/* nav drawer backdrop (sidebar is z-index 60, exam modal is 9000) */
.nav-backdrop{
  position:fixed;inset:0;z-index:55;
  background:rgba(20,26,12,.46);
  opacity:0;pointer-events:none;transition:opacity .2s ease;
  -webkit-backdrop-filter:blur(2px);backdrop-filter:blur(2px);
}
.nav-backdrop.show{opacity:1;pointer-events:auto}

/* install affordance */
.install-note{
  margin:0 0 18px;padding:14px 16px;
  display:flex;gap:14px;align-items:flex-start;justify-content:space-between;
  background:var(--acem-tint);border:1px solid var(--line);
  border-left:3px solid var(--acem);border-radius:var(--radius);
}
.install-note p{margin:0;font-size:13.5px;line-height:1.55;color:var(--ink-2)}
.install-note strong{color:var(--ink)}
.install-note .install-actions{display:flex;gap:8px;flex-shrink:0}
.install-steps{margin:10px 0 0;padding-left:18px;font-size:13px;line-height:1.7;color:var(--ink-2)}

/* the in-app confirm modal must clear the notch and home indicator */
.modal-backdrop{
  padding-top:calc(20px + var(--safe-top));
  padding-bottom:calc(20px + var(--safe-bottom));
  padding-left:calc(20px + var(--safe-left));
  padding-right:calc(20px + var(--safe-right));
}

/* phones */
@media (max-width:760px){
  .topbar{
    padding-top:calc(12px + var(--safe-top));
    padding-left:calc(16px + var(--safe-left));
    padding-right:calc(16px + var(--safe-right));
  }
  .quiz-head{top:calc(59px + var(--safe-top))}
  .sidebar{
    padding-top:calc(20px + var(--safe-top));
    padding-bottom:calc(24px + var(--safe-bottom));
    padding-left:calc(14px + var(--safe-left));
    width:min(84vw,300px);
  }
  .content{
    padding-left:calc(16px + var(--safe-left));
    padding-right:calc(16px + var(--safe-right));
    padding-bottom:calc(72px + var(--safe-bottom));
  }
  .quiz-actions{padding-bottom:calc(13px + var(--safe-bottom))}

  /* touch targets */
  .nav button,.cat-list button,.category-grid button,.modal-actions .button{min-height:44px}
  .option{min-height:52px}

  /* Progress, Categories and the exam timer on a 390px screen */
  .category-grid{grid-template-columns:1fr}
  .lens-cols{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
  .cat-toolbar{flex-wrap:wrap;gap:8px}
  .cat-toolbar .button,.cat-toolbar select,.cat-toolbar input{flex:1 1 auto;min-width:0}
  .timer-wrap{white-space:nowrap}
  .modal-actions{flex-direction:column-reverse}
  .modal-actions .button{width:100%}
  .install-note{flex-direction:column;align-items:stretch}
  .install-note .install-actions .button{flex:1}
}

/* charts and wide tables scroll rather than squash */
@media (max-width:560px){
  .kpi-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
  .hist-table{display:block;overflow-x:auto;-webkit-overflow-scrolling:touch}
}

/* standalone: no browser chrome, so lock down rubber-banding */
@media (display-mode:standalone){
  html,body{overscroll-behavior:none}
  .install-note{display:none!important}
}
</style>
</head>
<body>
<div class="app" id="appShell">
<aside class="sidebar" id="sidebar">
<div class="brand"><div class="brandmark"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.6 2h4.8v7.6H22v4.8h-7.6V22H9.6v-7.6H2V9.6h7.6V2Z"/></svg></div><div><h1>Fellowship Examination</h1><small>SCQ App</small></div></div>
<div class="nav">
<button class="active" data-view="dashboard" title="Dashboard"><span class="icon"><svg class="ui-icon nav-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg></span><span>Dashboard</span></button>
<button data-view="quiz" title="Practice exam"><span class="icon"><svg class="ui-icon nav-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path class="icon-fill" d="m8 5 11 7-11 7V5Z"/></svg></span><span>Practice exam</span></button>
<button data-view="categories" title="Categories"><span class="icon"><svg class="ui-icon nav-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="5" rx="1.5"/><rect x="3" y="12.5" width="18" height="5" rx="1.5"/><path d="M6.5 20.5h11"/></svg></span><span>Categories</span></button>
<button data-view="progress" title="Progress"><span class="icon"><svg class="ui-icon nav-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 19V5"/><path d="M4 19h16"/><path d="m7.5 15 3.5-4.5 3 2.5L20 6.5"/></svg></span><span>Progress</span></button>
<button data-view="answers" title="Answer key"><span class="icon"><svg class="ui-icon nav-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="m8 12 2.5 2.5L16.5 8.5"/></svg></span><span>Answer key</span></button>
<button data-view="review" title="Saved questions"><span class="icon"><svg class="ui-icon nav-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m12 3 2.78 5.63 6.22.9-4.5 4.39 1.06 6.2L12 17.2l-5.56 2.92 1.06-6.2L3 9.53l6.22-.9L12 3Z"/></svg></span><span>Saved questions</span></button>
<button data-view="disclaimer" title="Disclaimer"><span class="icon"><svg class="ui-icon nav-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M12 11v5"/><path d="M12 8h.01"/></svg></span><span>Disclaimer</span></button>
</div>
<div class="footer-note">Educational use only. Not an official ACEM product and not endorsed by ACEM.<div class="author-credit">Author: Dr Daryl Goh</div></div>
</aside>
<main class="main">
<header class="topbar">
<div style="display:flex;align-items:center;gap:10px"><button class="button ghost rail-toggle icon-only" id="railToggle" aria-label="Collapse navigation" aria-expanded="true" title="Collapse navigation"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16"/><path class="chev" d="m15.5 9.5-2.5 2.5 2.5 2.5"/></svg></button><button class="button ghost mobile-menu icon-only" id="menuBtn" aria-label="Open navigation" title="Open navigation"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button><div class="top-title"><h2 id="pageTitle">Dashboard</h2><p id="pageSubtitle">Practice, revision and progress in one place</p></div></div>
<div class="top-actions"><button class="button ghost icon-only" id="themeBtn" title="Toggle theme" aria-label="Toggle theme"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8"/><path class="icon-fill" d="M12 4a8 8 0 0 0 0 16V4Z"/></svg></button></div>
</header>
<div class="content">

<section class="view active" id="view-dashboard">
<div class="hero">
<div class="card hero-main"><div class="eyebrow">Fellowship Examination SCQ App</div><h3>Fellowship Written Examination Preparation</h3><p>The Fellowship Examination SCQ App was created and developed by Dr Daryl Goh as an educational resource for ACEM trainees preparing for the Fellowship Written SCQ Examination. The app is provided free of charge and is not officially endorsed by, affiliated with, or approved by the Australasian College for Emergency Medicine (ACEM).</p><div class="hero-actions"><button class="button primary large" id="heroStart">Practice Exam</button><button class="button large" data-view-jump="review">Saved Questions</button></div></div>
<div class="card hero-side"><div class="muted">Question bank</div><div class="big-number">2,700</div><div class="muted">22 categories · five options · one best answer</div><div class="session-note" id="heroNote"><strong>Progress is saved</strong><span>Every answer you submit is recorded in this browser and reported on the Progress page.</span></div></div>
</div>
<div class="grid" id="statsGrid"></div>
<div class="section-title"><div><h3>Your progress</h3><p>A snapshot of coverage and accuracy across the bank.</p></div><button class="button" data-view-jump="progress">Full progress report</button></div>
<div class="dash-progress" id="dashProgress"></div>
</section>

<section class="view" id="view-quiz">
<div class="card setup" id="quizSetup">
<div class="section-title" style="margin-top:0"><div><h3>Build an exam</h3><p>Tutor mode reveals the explanation as soon as you answer. Test mode holds every answer until you finish.</p></div></div>
<div class="form-grid">
<div class="field"><label for="quizCategory">Category</label><select id="quizCategory"></select></div>
<div class="field"><label for="quizLens">Lens</label><select id="quizLens"><option value="all">All lenses</option><option value="diagnosis">Diagnosis</option><option value="management">Management</option><option value="discriminator">Discriminator</option><option value="pitfall">Pitfall</option><option value="complication">Complication</option><option value="calculation">Calculation</option></select></div>
<div class="field"><label for="quizCount">Questions</label><select id="quizCount"><option>10</option><option selected="">20</option><option>30</option><option>50</option><option>100</option><option>120</option><option value="all">All available</option><option value="custom">Custom number…</option></select><div class="field-hint" id="quizPoolHint"></div></div><div class="field" id="quizCountCustomField" style="display:none"><label for="quizCountCustom">How many questions</label><input type="number" id="quizCountCustom" min="1" step="1" value="25" inputmode="numeric"><div class="field-hint" id="quizCountCustomHint"></div></div>
<div class="field"><label for="quizMode">Mode</label><select id="quizMode"><option value="study">Tutor</option><option value="exam">Test</option></select></div>
<div class="field" id="quizTimerField" style="display:none"><label for="quizTimer">Time limit</label><select id="quizTimer"><option value="0">No limit — count up</option><option value="600">10 minutes</option><option value="1200">20 minutes</option><option value="1800">30 minutes</option><option value="2700">45 minutes</option><option value="3600">60 minutes</option><option value="5400">90 minutes</option><option value="7200">120 minutes</option><option value="custom">Custom…</option></select><div class="field-hint" id="quizTimerHint"></div></div><div class="field" id="quizTimerCustomField" style="display:none"><label for="quizTimerCustom">Minutes</label><input type="number" id="quizTimerCustom" min="1" max="600" step="1" value="60" inputmode="numeric"></div><div class="field"><label for="quizOrder">Order</label><select id="quizOrder"><option value="random">Randomised</option><option value="sequential">Sequential</option></select></div>
</div>
<div class="setup-actions"><button class="button primary large" id="startQuiz">Start exam</button><button class="button" id="startBookmarks">Review bookmarks</button></div>
<div class="setup-hint">Keyboard during an exam — <kbd>1</kbd>–<kbd>5</kbd> choose, <kbd>Enter</kbd> submit, <kbd>N</kbd> next, <kbd>P</kbd> previous, <kbd>B</kbd> bookmark, <kbd>F</kbd> flag.</div>
</div>

<div class="quiz-shell" id="quizShell">
<div class="quiz-head">
<div class="quiz-meta"><span class="pill category" id="qCategory"></span><span class="lens" id="qType" data-lens=""></span><span class="pill">Difficulty 5/5</span></div>
<div class="muted"><span id="qPosition"></span><span class="timer-wrap"><span class="timer-label" id="timerLabel">Elapsed</span><span id="timer">00:00</span></span></div>
</div>
<div class="session-strip"><span id="sessionBar" style="width:0%"></span></div>
<div class="quiz-workspace">
<div class="quiz-main-column">
<div class="card question-card">
<div class="row"><span id="qNumber"></span><div class="question-controls"><button class="button ghost" id="bookmarkBtn" aria-pressed="false"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 4.75A1.75 1.75 0 0 1 7.75 3h8.5A1.75 1.75 0 0 1 18 4.75V21l-6-3.75L6 21V4.75Z"/></svg><span>Bookmark</span></button><button class="button ghost" id="flagBtn" aria-pressed="false"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 21V4m0 1h10.5l-1.5 3 1.5 3H5"/></svg><span>Flag</span></button></div></div>
<h3 id="qStem"></h3>
<div class="choice-label">Select one answer</div>
<div class="option-list" id="qOptions"></div>
<div class="feedback" id="qFeedback"></div>
</div>
<div class="quiz-actions"><div class="group"><button class="button" id="prevQ"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m15 18-6-6 6-6"/></svg><span>Previous</span></button><button class="button primary" id="submitQ">Submit answer</button></div><div class="group"><button class="button danger" id="finishQuiz">Finish exam</button><button class="button" id="nextQ"><span>Next</span><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 18 6-6-6-6"/></svg></button></div></div>
</div>
<aside aria-label="Question navigation" class="card question-navigator">
<div class="question-navigator-title">Question navigator</div>
<div class="question-navigator-summary muted" id="questionNavigatorSummary">Select a question number</div>
<div class="question-number-grid" id="questionNumberGrid"></div>
<div class="question-nav-legend">
<span><i class="legend-swatch current"></i>Current</span>
<span><i class="legend-swatch answered"></i>Answered</span>
<span><i class="legend-swatch flagged"></i>Flagged</span>
</div>
</aside>
</div>
</div>
<div class="results" id="quizResults"></div>
</section>

<section class="view" id="view-answers">
<div class="answer-controls"><select id="answerCategory"></select><input id="answerSearch" placeholder="Search stems, answers, explanations or learning points&#8230;"><button class="button" id="expandAnswers">Expand all</button></div>
<div id="answerList"></div>
</section>


<section class="view" id="view-progress">
<div id="progressBody"></div>
</section>

<section class="view" id="view-categories">
<div class="cat-toolbar">
<input id="catSearch" placeholder="Search categories&#8230;" aria-label="Search categories">
<select id="catSort" aria-label="Sort categories">
<option value="name">Sort: A to Z</option>
<option value="weakest">Sort: weakest accuracy</option>
<option value="least">Sort: least covered</option>
<option value="largest">Sort: most questions</option>
</select>
<span class="cat-summary" id="catSummary"></span>
</div>
<div class="category-grid" id="categoryGrid"></div>
</section>

