<script>
'use strict';
const QUESTIONS=JSON.parse(document.getElementById('question-data').textContent);
const META=JSON.parse(document.getElementById('meta-data').textContent);
const STORE_KEY='acem-fellowship-mcq-v1';
const ACCOUNT_STORE_KEY='qeii-ed-scq-users-v1';
const LETTERS=['A','B','C','D','E'];
const UI_ICON_PATHS={
 bookmark:'<path d="M6 4.75A1.75 1.75 0 0 1 7.75 3h8.5A1.75 1.75 0 0 1 18 4.75V21l-6-3.75L6 21V4.75Z"/>',
 bookmarkFilled:'<path class="icon-fill" d="M6 4.75A1.75 1.75 0 0 1 7.75 3h8.5A1.75 1.75 0 0 1 18 4.75V21l-6-3.75L6 21V4.75Z"/>',
 flag:'<path d="M5 21V4m0 1h10.5l-1.5 3 1.5 3H5"/>',
 flagFilled:'<path class="icon-fill" d="M5 21V4m0 1h10.5l-1.5 3 1.5 3H5Z"/>',
 right:'<path d="m9 18 6-6-6-6"/>',
 left:'<path d="m15 18-6-6 6-6"/>'
};
function uiIcon(name,extraClass=''){return `<svg class="ui-icon ${extraClass}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">${UI_ICON_PATHS[name]||''}</svg>`}
function setLabeledButton(button,iconName,label){button.innerHTML=`${uiIcon(iconName)}<span>${e(label)}</span>`}

const byId=new Map(QUESTIONS.map(q=>[q.id,q]));
const categories=Object.keys(META.categoryCounts);
let currentView='dashboard';
let session=null;
let timerHandle=null;
let answerExpanded=false;
let state=loadState();
function validIds(items){return [...new Set((items||[]).filter(id=>byId.has(id)))]}
function blankState(theme='light'){return {bookmarks:[],theme,railCollapsed:false,progress:blankProgress()}}
function sanitiseState(x={}){return {bookmarks:validIds(x.bookmarks),theme:x.theme||'light',railCollapsed:!!x.railCollapsed,progress:sanitiseProgress(x.progress)}}
function loadState(){
  try{
    const direct=localStorage.getItem(STORE_KEY);
    if(direct)return sanitiseState(JSON.parse(direct));
    const accounts=JSON.parse(localStorage.getItem(ACCOUNT_STORE_KEY)||'{}');
    const activeId=accounts&&accounts.activeUserId;
    if(activeId){
      const accountState=localStorage.getItem(`qeii-ed-scq-progress-v1:${activeId}`);
      if(accountState){
        const migrated=sanitiseState(JSON.parse(accountState));
        localStorage.setItem(STORE_KEY,JSON.stringify(migrated));
        return migrated;
      }
    }
  }catch(err){}
  return blankState();
}
function persist(){try{localStorage.setItem(STORE_KEY,JSON.stringify(state))}catch(err){toast('Storage is full; progress may not be saved')}}
function saveState(){persist();renderGlobal()}
function newId(){if(window.crypto&&crypto.randomUUID)return crypto.randomUUID();return 'q-'+Date.now().toString(36)+'-'+Math.random().toString(36).slice(2)}
function e(s){return String(s).replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]))}
function toast(msg){const t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),1800)}
function shuffle(arr,seed=Math.random()){const a=[...arr];let x=typeof seed==='number'?Math.floor(seed*2147483647):Date.now();for(let i=a.length-1;i>0;i--){x=(x*48271)%2147483647;const j=x%(i+1);[a[i],a[j]]=[a[j],a[i]]}return a}
function setTheme(){document.documentElement.classList.toggle('dark',state.theme==='dark')}
function setRail(){const shell=document.getElementById('appShell');if(!shell)return;shell.classList.toggle('rail-collapsed',!!state.railCollapsed);const b=document.getElementById('railToggle');if(b){const lbl=state.railCollapsed?'Expand navigation':'Collapse navigation';b.title=lbl;b.setAttribute('aria-label',lbl);b.setAttribute('aria-expanded',String(!state.railCollapsed))}}
/* ============================================================
   PROGRESS ENGINE
   Persists attempts, sessions and daily activity to localStorage
   alongside bookmarks and flags. All derived statistics are
   computed on read so the stored payload stays small.
   ============================================================ */
const CAT_INDEX=new Map();
QUESTIONS.forEach(q=>{if(!CAT_INDEX.has(q.category))CAT_INDEX.set(q.category,[]);CAT_INDEX.get(q.category).push(q)});
const LENS_INDEX=new Map();
QUESTIONS.forEach(q=>{if(!LENS_INDEX.has(q.type))LENS_INDEX.set(q.type,[]);LENS_INDEX.get(q.type).push(q)});
/* LENS_ORDER is declared further down the file, so the canonical order is
   restated here; any lens present in the data but missing from it is appended. */
const LENS_SEQUENCE=['diagnosis','management','discriminator','pitfall','complication','calculation'];
const ACTIVE_LENSES=LENS_SEQUENCE.filter(l=>LENS_INDEX.has(l))
  .concat([...LENS_INDEX.keys()].filter(l=>LENS_SEQUENCE.indexOf(l)<0));
const MIN_FOR_RANKING=8;
const MAX_SESSIONS=150;

function blankProgress(){return {q:{},sessions:[],days:{},time:0}}
function sanitiseProgress(p){
  const out=blankProgress();
  if(!p||typeof p!=='object')return out;
  if(p.q&&typeof p.q==='object'){
    Object.keys(p.q).forEach(id=>{
      if(!byId.has(id))return;
      const r=p.q[id]||{};const n=Math.max(0,parseInt(r.n,10)||0);
      if(!n)return;
      out.q[id]={n,c:Math.min(n,Math.max(0,parseInt(r.c,10)||0)),last:r.last?1:0,first:r.first?1:0,t:Number(r.t)||0};
    });
  }
  if(Array.isArray(p.sessions)){
    out.sessions=p.sessions.filter(s=>s&&typeof s==='object'&&s.total).slice(-MAX_SESSIONS).map(s=>({
      id:String(s.id||''),ts:Number(s.ts)||0,mode:s.mode==='exam'?'exam':'study',
      scope:String(s.scope||'Mixed'),total:Math.max(0,parseInt(s.total,10)||0),
      answered:Math.max(0,parseInt(s.answered,10)||0),correct:Math.max(0,parseInt(s.correct,10)||0),
      dur:Math.max(0,parseInt(s.dur,10)||0)
    }));
  }
  if(p.days&&typeof p.days==='object'){
    Object.keys(p.days).forEach(k=>{
      if(!/^\d{4}-\d{2}-\d{2}$/.test(k))return;
      const d=p.days[k]||{};const a=Math.max(0,parseInt(d.a,10)||0);
      if(!a)return;
      out.days[k]={a,c:Math.min(a,Math.max(0,parseInt(d.c,10)||0))};
    });
  }
  out.time=Math.max(0,Number(p.time)||0);
  return out;
}
function prog(){if(!state.progress)state.progress=blankProgress();return state.progress}
function dayKey(d){const x=d||new Date();return `${x.getFullYear()}-${String(x.getMonth()+1).padStart(2,'0')}-${String(x.getDate()).padStart(2,'0')}`}
function fromDayKey(k){const p=k.split('-');return new Date(Number(p[0]),Number(p[1])-1,Number(p[2]))}

function recordAnswer(q,selectedIndex,opts){
  const unanswered=!!(opts&&opts.unanswered);
  if(!q)return;
  if(!unanswered&&(selectedIndex===undefined||selectedIndex===null))return;
  const P=prog();
  const correct=unanswered?0:(selectedIndex===q.answerIndex?1:0);
  const rec=P.q[q.id]||{n:0,c:0,last:0,first:0,t:0};
  if(rec.n===0)rec.first=correct;
  rec.n+=1;rec.c+=correct;rec.last=correct;rec.t=Date.now();
  P.q[q.id]=rec;
  const key=dayKey();
  const day=P.days[key]||{a:0,c:0};
  day.a+=1;day.c+=correct;P.days[key]=day;
}
function commitSession(){
  if(!session||session.committed)return;
  session.committed=true;
  session.recorded=session.recorded||{};
  const P=prog();
  const strict=session.mode==='exam';
  session.ids.forEach(id=>{
    const sel=session.selected[id];
    if(session.recorded[id])return;
    if(sel===undefined){
      /* Tutor mode: an unanswered question is never recorded, so it stays in the
         unattempted pool. Test mode: it counts as an incorrect attempt. */
      if(!strict)return;
      recordAnswer(byId.get(id),undefined,{unanswered:true});
    }else{
      recordAnswer(byId.get(id),sel);
    }
    session.recorded[id]=true;
  });
  const answered=session.ids.filter(id=>session.selected[id]!==undefined).length;
  if(!answered&&!strict)return;
  const correct=session.ids.filter(id=>session.selected[id]===byId.get(id).answerIndex).length;
  const dur=Math.max(0,Math.round((Date.now()-session.started)/1000));
  P.time+=dur;
  P.sessions.push({id:session.id,ts:Date.now(),mode:session.mode,scope:session.scope||'Mixed',
    total:session.ids.length,answered,correct,dur});
  if(P.sessions.length>MAX_SESSIONS)P.sessions=P.sessions.slice(-MAX_SESSIONS);
}

/* ---------- derived statistics ---------- */
function bandOf(rec){
  if(!rec||!rec.n)return 'unseen';
  const a=rec.c/rec.n;
  if(a>=0.8)return 'strong';
  if(a>=0.5)return 'fair';
  return 'weak';
}
function attemptedIds(){const g=prog().q;return Object.keys(g).filter(id=>byId.has(id))}
function incorrectIds(){const g=prog().q;return Object.keys(g).filter(id=>byId.has(id)&&!g[id].last)}
function poolStats(pool){
  const g=prog().q;
  let seen=0,attempts=0,correct=0,firstCorrect=0,weak=0,fair=0,strong=0;
  pool.forEach(q=>{
    const r=g[q.id];
    if(!r||!r.n)return;
    seen++;attempts+=r.n;correct+=r.c;firstCorrect+=r.first;
    const b=bandOf(r);
    if(b==='weak')weak++;else if(b==='fair')fair++;else strong++;
  });
  const total=pool.length;
  return {total,seen,unseen:total-seen,attempts,correct,incorrect:attempts-correct,
    accuracy:attempts?correct/attempts*100:0,
    firstAccuracy:seen?firstCorrect/seen*100:0,
    coverage:total?seen/total*100:0,weak,fair,strong};
}
function statsFor(cat=null){
  const s=poolStats(cat?(CAT_INDEX.get(cat)||[]):QUESTIONS);
  return {total:s.total,attempted:s.seen,correct:s.correct,accuracy:s.accuracy,stats:s};
}
function overallStats(){return poolStats(QUESTIONS)}
function streakInfo(){
  const days=prog().days;
  const keys=Object.keys(days);
  if(!keys.length)return {current:0,best:0,activeDays:keys.length};
  const set=new Set(keys);
  let current=0;
  const probe=new Date();
  if(!set.has(dayKey(probe)))probe.setDate(probe.getDate()-1);
  while(set.has(dayKey(probe))){current++;probe.setDate(probe.getDate()-1)}
  const sorted=keys.sort();
  let best=0,run=0,prev=null;
  sorted.forEach(k=>{
    const d=fromDayKey(k);
    if(prev&&Math.round((d-prev)/86400000)===1)run++;else run=1;
    if(run>best)best=run;
    prev=d;
  });
  return {current,best,activeDays:keys.length};
}
function fmtDuration(sec){
  sec=Math.max(0,Math.round(sec));
  const h=Math.floor(sec/3600),m=Math.floor((sec%3600)/60);
  if(h)return `${h}h ${m}m`;
  if(m)return `${m}m`;
  return `${sec}s`;
}
function fmtClock(sec){
  sec=Math.max(0,Math.round(sec));
  return `${String(Math.floor(sec/60)).padStart(2,'0')}:${String(sec%60).padStart(2,'0')}`;
}
function fmtDate(ts){
  const d=new Date(ts);
  return d.toLocaleDateString(undefined,{day:'numeric',month:'short'})+' '+d.toLocaleTimeString(undefined,{hour:'2-digit',minute:'2-digit'});
}
function band(pct){return pct<50?'low':pct<75?'mid':''}

/* ---------- chart builders (inline SVG, no dependencies) ---------- */
function lineChart(points,opt){
  opt=opt||{};
  const w=opt.w||760,h=opt.h||210,padL=34,padR=12,padT=12,padB=26;
  const iw=w-padL-padR,ih=h-padT-padB,n=points.length;
  const px=i=>n<=1?padL+iw/2:padL+(i/(n-1))*iw;
  const py=v=>padT+ih-(Math.max(0,Math.min(100,v))/100)*ih;
  const grid=[0,25,50,75,100].map(v=>
    `<line class="chart-grid-line" x1="${padL}" y1="${py(v).toFixed(1)}" x2="${w-padR}" y2="${py(v).toFixed(1)}"/>`+
    `<text class="chart-axis-text" x="${padL-7}" y="${(py(v)+3.5).toFixed(1)}" text-anchor="end">${v}</text>`
  ).join('');
  const line=points.map((p,i)=>`${i?'L':'M'}${px(i).toFixed(1)} ${py(p.value).toFixed(1)}`).join(' ');
  const area=`${line} L${px(n-1).toFixed(1)} ${(padT+ih).toFixed(1)} L${px(0).toFixed(1)} ${(padT+ih).toFixed(1)} Z`;
  const mean=points.reduce((a,p)=>a+p.value,0)/n;
  const dots=points.map((p,i)=>
    `<circle class="chart-dot" cx="${px(i).toFixed(1)}" cy="${py(p.value).toFixed(1)}" r="3.6"/>`+
    `<circle class="chart-dot-hit" cx="${px(i).toFixed(1)}" cy="${py(p.value).toFixed(1)}" r="11"><title>${e(p.label)} — ${Math.round(p.value)}%</title></circle>`
  ).join('');
  const step=Math.max(1,Math.ceil(n/8));
  const xlabels=points.map((p,i)=>(i%step===0||i===n-1)
    ?`<text class="chart-axis-text" x="${px(i).toFixed(1)}" y="${h-7}" text-anchor="middle">${e(p.short||'')}</text>`:'').join('');
  return `<div class="chart-frame"><svg viewBox="0 0 ${w} ${h}" role="img" aria-label="${e(opt.aria||'Performance trend')}" >
${grid}<path class="chart-area" d="${area}"/><path class="chart-line" d="${line}"/>
<line class="chart-mean" x1="${padL}" y1="${py(mean).toFixed(1)}" x2="${w-padR}" y2="${py(mean).toFixed(1)}"><title>Average ${Math.round(mean)}%</title></line>
${dots}${xlabels}</svg></div>`;
}
function donut(pct,centre,label){
  const r=66,c=2*Math.PI*r,filled=Math.max(0,Math.min(100,pct))/100*c;
  return `<div class="donut"><svg viewBox="0 0 158 158" aria-hidden="true">
<circle class="donut-track" cx="79" cy="79" r="${r}"/>
<circle class="donut-arc" cx="79" cy="79" r="${r}" stroke-dasharray="${filled.toFixed(1)} ${(c-filled).toFixed(1)}"/>
</svg><div class="donut-centre"><div><strong>${centre}</strong><span>${e(label)}</span></div></div></div>`;
}
function lensColumns(){
  const g=prog().q;
  return `<div class="lens-cols">${ACTIVE_LENSES.map(l=>{
    const s=poolStats(LENS_INDEX.get(l)||[]);
    const pct=s.attempts?Math.round(s.accuracy):0;
    return `<div class="lens-col ${s.attempts?'':'dim'}" data-lens="${e(l)}">
<span class="lc-pct">${s.attempts?pct+'%':'—'}</span>
<div class="lc-track"><span class="lc-fill" style="height:${s.attempts?Math.max(3,pct):0}%"></span></div>
<span class="lc-name">${e(LENS_LABEL[l]||l)}</span>
<span class="lc-n">${s.correct}/${s.attempts}</span></div>`;
  }).join('')}</div>`;
}
function heatmap(weeks){
  weeks=weeks||26;
  const days=prog().days;
  const today=new Date();today.setHours(0,0,0,0);
  const end=new Date(today);end.setDate(end.getDate()+(6-end.getDay()));
  const start=new Date(end);start.setDate(start.getDate()-(weeks*7-1));
  const counts=Object.values(days).map(d=>d.a);
  const peak=counts.length?Math.max.apply(null,counts):0;
  const level=n=>{if(!n)return '';if(!peak)return 'l1';const r=n/peak;return r>=.75?'l4':r>=.45?'l3':r>=.2?'l2':'l1'};
  let cols='',months='',lastMonth=-1;
  const cursor=new Date(start);
  for(let wk=0;wk<weeks;wk++){
    let cells='',monthLabel='';
    for(let d=0;d<7;d++){
      const key=dayKey(cursor);
      const rec=days[key];
      const future=cursor>today;
      const title=future?'':`${cursor.toLocaleDateString(undefined,{day:'numeric',month:'short'})} — ${rec?`${rec.a} answered, ${Math.round(rec.c/rec.a*100)}% correct`:'no practice'}`;
      cells+=`<span class="heat-cell ${future?'future':level(rec?rec.a:0)}"${title?` title="${e(title)}"`:''}></span>`;
      if(d===0&&cursor.getMonth()!==lastMonth){monthLabel=cursor.toLocaleDateString(undefined,{month:'short'});lastMonth=cursor.getMonth()}
      cursor.setDate(cursor.getDate()+1);
    }
    cols+=`<div class="heat-col">${cells}</div>`;
    months+=`<span>${monthLabel}</span>`;
  }
  return `<div class="heat-months">${months}</div><div class="heat">${cols}</div>
<div class="heat-foot"><span>Less</span><span class="heat-cell"></span><span class="heat-cell l1"></span><span class="heat-cell l2"></span><span class="heat-cell l3"></span><span class="heat-cell l4"></span><span>More</span></div>`;
}

/* ---------- targeted practice ---------- */
function targetPool(opt){
  opt=opt||{};
  const g=prog().q;
  let pool=opt.cat?(CAT_INDEX.get(opt.cat)||[]):QUESTIONS;
  if(opt.lens)pool=pool.filter(q=>q.type===opt.lens);
  if(opt.kind==='incorrect')pool=pool.filter(q=>g[q.id]&&!g[q.id].last);
  else if(opt.kind==='unseen')pool=pool.filter(q=>!g[q.id]);
  else if(opt.kind==='weak')pool=pool.filter(q=>{const r=g[q.id];return !r||bandOf(r)!=='strong'});
  return pool;
}
function startTargeted(opt){
  opt=opt||{};
  const pool=targetPool(opt);
  if(!pool.length){toast(opt.emptyMessage||'No questions match that filter');return}
  const count=Math.min(opt.count||20,pool.length);
  const ids=shuffle(pool).slice(0,count).map(q=>q.id);
  showView('quiz');
  startSession(ids,'study','random',opt.scope||'Targeted practice');
}

